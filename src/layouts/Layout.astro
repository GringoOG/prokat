---
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/latin-ext-400.css';
import '@fontsource/inter/latin-ext-500.css';
import '@fontsource/inter/latin-ext-600.css';
import '@fontsource/inter/latin-ext-700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Prokat Invest',
  description = 'PROKAT invest — spolehlivý partner pro systémová řešení vzduchotechniky, vytápění, chlazení a ZTI od roku 1999.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="cs" class="overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      as="image"
      href="/images/pozadi-prokat-v3.webp"
      type="image/webp"
    />
    <style is:inline>
      :root {
        --site-header-spacer: calc(3.5rem + env(safe-area-inset-top, 0px));
      }
      .site-header-spacer {
        height: var(--site-header-spacer);
        min-height: var(--site-header-spacer);
      }
      .hero-shell {
        min-height: 520px;
      }
      @media (min-width: 1024px) {
        :root {
          --site-header-spacer: calc(5rem + env(safe-area-inset-top, 0px));
        }
        .hero-shell {
          min-height: 680px;
        }
      }
    </style>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      function initScrollReveal() {
        const targets = document.querySelectorAll(
          [
            '.section-watermark > section',
            '.services-watermark > section',
            '.contact-page > main > section',
            'main > section',
            'footer',
            '[data-reveal]',
          ].join(', '),
        );

        targets.forEach((el) => {
          if (el.classList.contains('reveal')) return;
          if (el.classList.contains('reveal-skip')) return;
          el.classList.add('reveal');
        });

        const reveals = document.querySelectorAll('.reveal');
        if (!reveals.length) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          reveals.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const initiallyVisible = [];
        reveals.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < window.innerHeight * 0.92 && rect.bottom > 0) {
            initiallyVisible.push(el);
          }
        });

        initiallyVisible.forEach((el, i) => {
          el.style.setProperty('--reveal-delay', `${220 + i * 180}ms`);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target;
              if (!initiallyVisible.includes(el) && !el.style.getPropertyValue('--reveal-delay')) {
                el.style.setProperty('--reveal-delay', '80ms');
              }
              el.classList.add('is-visible');
              observer.unobserve(el);
            });
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.12 },
        );

        reveals.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollReveal);
      } else {
        initScrollReveal();
      }
    </script>
  </body>
</html>
