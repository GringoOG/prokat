---
const clients = [
  { src: '/images/client-hutchinson.png', alt: 'Hutchinson' },
  { src: '/images/client-pilsner.png', alt: 'Pilsner Urquell' },
  { src: '/images/client-skoda.png', alt: 'Škoda' },
  { src: '/images/client-autoopat.png', alt: 'Auto Opat' },
  { src: '/images/client-centralgroup.png', alt: 'Central Group' },
  { src: '/images/client-xxxlutz.png', alt: 'XXXLutz' },
  { src: '/images/client-mobelix.png', alt: 'Möbelix' },
];

/** Stejně široké skupiny → bez mezery na spoji i na začátku */
const sets = 4;
---

<section class="w-full overflow-hidden bg-white py-[25px]" aria-label="Reference klientů">
  <div class="client-marquee relative overflow-hidden">
    <div class="marquee-track">
      {
        Array.from({ length: sets }).map((_, setIndex) => (
          <div class="marquee-group" aria-hidden={setIndex > 0 ? true : undefined}>
            {clients.map((client) => (
              <div class="client-logo-slot">
                <img
                  src={client.src}
                  alt={setIndex === 0 ? client.alt : ''}
                  class="client-logo-img"
                  loading={setIndex === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
