---
const pathname = Astro.url.pathname;

const isActive = (href: string) =>
  href === '/'
    ? pathname === '/'
    : href !== '#' && (pathname === href || pathname.startsWith(`${href}/`));

const footerLinkClass = (href: string) =>
  isActive(href)
    ? 'text-gold transition-colors'
    : 'text-[#a7a3a2] hover:text-gold transition-colors';
---

<footer class="panel-gold-dark relative overflow-hidden text-white">
  <img
    src="/images/footer-watermark.png"
    alt=""
    class="pointer-events-none absolute left-1/2 top-[42%] z-0 w-full max-w-[900px] -translate-x-1/2 -translate-y-1/2 object-contain opacity-[0.12] select-none"
    aria-hidden="true"
  />

  <div class="relative z-10 mx-auto max-w-5xl px-6 pb-6 pt-16 lg:px-8 lg:pb-8 lg:pt-20">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-3 lg:gap-12">
      <div>
        <h2 class="mb-6 text-xl font-semibold text-white lg:text-[28px]">Odkazy</h2>
        <ul class="space-y-3 text-base font-medium lg:text-[23px]">
          <li><a href="/" class={footerLinkClass('/')}>Domů</a></li>
          <li><a href="/o-nas" class={footerLinkClass('/o-nas')}>O nás</a></li>
          <li><a href="/sluzby" class={footerLinkClass('/sluzby')}>Služby</a></li>
        </ul>
      </div>

      <div class="lg:pt-[3.25rem]">
        <ul class="space-y-3 text-base font-medium lg:text-[23px]">
          <li><a href="/projekty" class={footerLinkClass('/projekty')}>Projekty</a></li>
          <li><a href="/kontakt" class={footerLinkClass('/kontakt')}>Kontakt</a></li>
          <li><a href="#" class={footerLinkClass('#')}>GDPR</a></li>
        </ul>
      </div>

      <div>
        <h2 class="mb-6 text-xl font-semibold text-white lg:text-[28px]">Kontakt</h2>
        <a
          href="https://www.linkedin.com/company/prokat-invest-s-r-o/"
          target="_blank"
          rel="noopener noreferrer"
          class="mb-4 inline-flex items-center gap-3 text-base font-medium text-[#a7a3a2] transition-colors hover:text-gold lg:text-[23px]"
        >
          <img src="/icons/linkedin.png" alt="" class="h-8 w-8 rounded" width="32" height="32" />
          LinkedIn
        </a>
        <p class="text-base font-medium leading-snug text-[#a7a3a2] lg:text-[23px]">
          <a
            href="https://maps.google.com/?q=Plzeňská+1348/95,+Praha"
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-gold"
          >
            Plzeňská 1348/95, Praha 150 00
          </a>
        </p>
      </div>
    </div>

    <div class="mt-12 space-y-2 text-center text-xs font-medium text-white/50 sm:text-sm lg:mt-14 lg:text-base">
      <p>Copyright © 2026 | PROKAT invest s.r.o. | Všechna práva vyhrazena.</p>
      <p>
        Made by
        <a
          href="https://www.webovice.cz"
          target="_blank"
          rel="noopener noreferrer"
          class="text-white/60 transition-colors hover:text-gold"
        >
          WebOvice
        </a>
      </p>
    </div>
  </div>
</footer>
