---
const services = [
  {
    id: 'chlazeni',
    title: 'Chlazení',
    image: '/images/service-cooling.png',
    alt: 'Chlazení',
    points: [
      'Studie vhodnosti použití způsobu chlazení jednotlivých aplikacích',
      'Provozní náklady',
      'Rekuperace a akumulace chladu',
      'Použití chladiv s nízkým koeficientem GWP (vliv chladiva na ozónovou díru)',
    ],
  },
  {
    id: 'fotovoltaika',
    title: 'Fotovoltaika',
    image: '/images/service-solar.png',
    alt: 'Fotovoltaika',
    points: [
      'Volba velikosti FVE s ohledem na návratnost',
      'Ukládání energie do baterek, sdílení energie',
      'Analýza trendů',
      'Servisní činnost',
    ],
  },
  {
    id: 'topne-zdroje',
    title: 'Topné zdroje',
    image: '/images/service-heating.jpg',
    alt: 'Topné zdroje',
    points: [
      'Výpočty spotřeb tepla dle norem',
      'Provozní náklady',
      'Alternativní zdroje tepla',
      'Rekuperace tepla',
    ],
  },
  {
    id: 'vzduchotechnika',
    title: 'Vzduchotechnika',
    image: '/images/service-hvac.jpg',
    alt: 'Vzduchotechnika',
    points: [
      'Garance mikroklimatických podmínek',
      'Přizpůsobení provozním režimům',
      'Rekuperace tepla a chladu',
      'Garance úzkých pásem tolerance mikroklimatických podmínek pro technologické procesy',
    ],
  },
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
  {
    services.map((service) => (
      <a
        id={service.id}
        href="/kontakt"
        class="group scroll-mt-28 bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-md hover:border-gold/30 transition-all"
      >
        <img
          src={service.image}
          alt={service.alt}
          class="w-full h-48 sm:h-56 lg:h-64 object-cover"
          loading="lazy"
        />
        <div class="p-6 lg:p-8">
          <h2 class="text-xl lg:text-[28px] font-semibold text-navy group-hover:text-gold transition-colors">
            {service.title}
          </h2>
          <ul class="mt-4 space-y-2 text-base lg:text-lg font-medium text-navy/80">
            {service.points.map((point) => (
              <li class="flex items-start gap-2">
                <img src="/icons/check.svg" alt="" class="mt-1.5 shrink-0" width="15" height="10" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      </a>
    ))
  }
</div>
