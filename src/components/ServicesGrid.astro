---
import { serviceHref, services } from '../data/services';
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
  {
    services.map((service) => (
      <a
        id={service.slug}
        href={serviceHref(service.slug)}
        class="service-card group scroll-mt-28 overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm transition-all hover:border-gold/30 hover:shadow-md"
      >
        <div class="service-media">
          <img
            src={service.image}
            alt={service.title}
            class="h-48 w-full object-cover sm:h-56 lg:h-64"
            loading="lazy"
          />
        </div>
        <div class="p-6 lg:p-8">
          <h2 class="text-xl lg:text-[28px] font-semibold text-navy group-hover:text-gold transition-colors">
            {service.title}
          </h2>
          <ul class="mt-4 space-y-2 text-base lg:text-lg font-medium text-navy/80">
            {service.listPoints.map((point) => (
              <li class="flex items-start gap-2">
                <img src="/icons/check.svg" alt="" class="mt-1.5 shrink-0" width="15" height="10" />
                {point}
              </li>
            ))}
          </ul>
        </div>
      </a>
    ))
  }
</div>
