---
import { contactDepartments } from '../data/contacts';

interface Props {
  class?: string;
}

const { class: className = 'bg-white' } = Astro.props;
---

<section class:list={['reveal-skip pb-16 pt-8 lg:pb-20 lg:pt-12', className]}>
  <div class="mx-auto max-w-site px-6 lg:px-[28px]">
    <h2
      data-reveal
      class="mb-8 text-center text-2xl font-semibold leading-snug text-navy sm:mb-10 sm:text-3xl lg:mb-16 lg:text-[40px]"
    >
      Kontaktní osoby
    </h2>

    <div class="space-y-8 lg:space-y-14">
      {
        contactDepartments.map((department) => (
          <div
            data-reveal
            class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[minmax(12rem,16rem)_1fr] lg:gap-10 xl:grid-cols-[minmax(14rem,18rem)_1fr] xl:gap-14"
          >
            <h3 class="text-center text-lg font-semibold leading-snug text-navy lg:pt-1 lg:text-left lg:text-xl">
              {department.title}
            </h3>

            <div class="grid grid-cols-1 gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3 lg:gap-y-10">
              {department.people.map((person) => (
                <div class="space-y-1 text-center text-base font-medium text-navy/90 lg:text-[21px]">
                  {person.location && (
                    <p class="text-xs font-semibold uppercase tracking-wide text-navy/50 lg:text-sm">
                      {person.location}
                    </p>
                  )}
                  <p class="font-semibold text-navy">{person.name}</p>
                  {person.role && person.role !== person.location && (
                    <p class="text-navy/70">{person.role}</p>
                  )}
                  <p>
                    <a href={`tel:${person.phone.replace(/\s/g, '')}`} class="transition-colors hover:text-gold">
                      {person.phone}
                    </a>
                  </p>
                  <p>
                    <a
                      href={`mailto:${person.email}`}
                      class="break-all transition-colors hover:text-gold"
                    >
                      {person.email}
                    </a>
                  </p>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
