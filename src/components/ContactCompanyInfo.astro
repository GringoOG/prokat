---
import { companyInfo } from '../data/contacts';

const leftBlocks = [companyInfo.headquarters, companyInfo.operations];
const rightBlocks = [companyInfo.bank, companyInfo.technicalOffice];
---

<div
  class="grid grid-cols-1 gap-10 text-center text-base font-medium leading-relaxed text-navy/90 sm:text-lg md:grid-cols-2 md:items-center md:gap-x-12 lg:text-[21px]"
>
  <div class="space-y-8 sm:space-y-10">
    {
      leftBlocks.map((block) => (
        <div data-reveal>
          <h2 class="mb-2 font-semibold text-navy">{block.title}</h2>
          {block.lines.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      ))
    }
  </div>

  <div class="space-y-5 sm:space-y-6">
    {
      rightBlocks.map((block) => (
        <div data-reveal>
          <h2 class="mb-2 font-semibold text-navy">{block.title}</h2>
          {block.lines.map((line) => (
            <p>{line}</p>
          ))}
        </div>
      ))
    }
  </div>
</div>
