---
import FlipButton from './FlipButton.astro';
---

<section class="mx-auto max-w-site px-6 lg:px-10 py-12 lg:py-16">
  <div class="relative overflow-hidden rounded-3xl bg-navy">
    <img
      src="/images/cta-bg.png"
      alt=""
      class="absolute inset-0 w-full h-full object-cover opacity-40"
      aria-hidden="true"
    />
    <div class="relative flex flex-col lg:flex-row items-center justify-between gap-8 p-8 lg:p-12">
      <h2 class="text-2xl sm:text-3xl lg:text-[40px] font-semibold text-white leading-tight max-w-2xl">
        Pojďme probrat vaše potřeby v oblasti TZB a energetiky.
      </h2>
      <FlipButton
        href="/kontakt"
        label="Poptat technické řešení"
        variant="white"
        class="shrink-0 w-full sm:w-auto"
        iconClass="btn-gradient-icon flex h-10 w-10 items-center justify-center rounded-full"
      />
    </div>
  </div>
</section>
