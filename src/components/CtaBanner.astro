---
import FlipButton from './FlipButton.astro';
---

<section class="services-watermark pt-2 pb-12 lg:pt-4 lg:pb-16">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-10">
    <div class="cta-banner-panel relative overflow-hidden rounded-lg">
      <div
        class="relative flex flex-col items-start justify-between gap-5 px-5 py-6 sm:gap-6 sm:px-8 sm:py-8 lg:flex-row lg:items-center lg:gap-10 lg:px-10 lg:py-9"
      >
        <h2
          class="max-w-none text-xl font-semibold leading-snug text-white sm:max-w-[22rem] sm:text-[28px] lg:max-w-md lg:text-[32px]"
        >
          Pojďme probrat vaše potřeby v oblasti TZB a energetiky.
        </h2>
        <FlipButton
          href="/kontakt"
          label="Poptat technické řešení"
          class="w-auto shrink-0 self-start"
          iconClass="btn-gradient-icon btn-shape-icon flex h-10 w-10 shrink-0 items-center justify-center"
        />
      </div>
    </div>
  </div>
</section>
