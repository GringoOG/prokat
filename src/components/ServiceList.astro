---
import { serviceHref, services } from '../data/services';
---

<div class="service-stack">
  {
    services.map((service, index) => (
      <article
        class="service-stack-item grid grid-cols-1 items-center gap-4 border border-gray-100 bg-white p-4 shadow-sm sm:grid-cols-[minmax(160px,200px)_1fr] sm:gap-5 sm:p-5 md:grid-cols-[minmax(200px,240px)_1fr] md:gap-6 md:p-6 lg:grid-cols-[auto_280px_minmax(0,1fr)_auto] lg:gap-8 lg:p-8"
        style={`z-index: ${index + 1};`}
      >
        <img
          src="/icons/service-icon.png"
          alt=""
          class="hidden h-10 w-10 object-contain lg:block"
          aria-hidden="true"
        />
        <a
          href={serviceHref(service.slug)}
          class="service-media block shrink-0 self-stretch sm:row-span-2 lg:row-span-1"
          aria-label={service.ariaLabel}
        >
          <img
            src={service.image}
            alt={service.title}
            class="h-[180px] w-full object-cover sm:h-full sm:min-h-[160px] sm:w-full md:min-h-[180px] lg:h-[200px] lg:w-[280px]"
          />
        </a>
        <div class="min-w-0 space-y-3 text-sm font-medium sm:text-base lg:max-w-[52ch] lg:text-[23px]">
          <h3 class="text-lg font-semibold text-navy sm:text-xl lg:text-[28px]">
            <a href={serviceHref(service.slug)} class="hover:text-gold transition-colors">
              {service.title}
            </a>
          </h3>
          <ul class="space-y-2 text-navy/90">
            {service.listPoints.map((point) => (
              <li class="flex items-start gap-2">
                <img src="/icons/check.svg" alt="" class="mt-2 shrink-0" width="15" height="10" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
        <a
          href={serviceHref(service.slug)}
          class="btn-flip btn-flip--icon-only btn-gradient-icon btn-shape-icon inline-flex h-10 w-10 shrink-0 items-center justify-center justify-self-end sm:col-start-2 lg:col-start-auto"
          aria-label={service.ariaLabel}
        >
          <span class="btn-flip-icon inline-flex items-center justify-center">
            <img src="/icons/arrow.svg" alt="" class="h-3 w-4" width="16" height="12" />
          </span>
        </a>
      </article>
    ))
  }
</div>
