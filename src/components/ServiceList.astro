---
const services = [
  {
    id: 'vzduchotechnika',
    title: 'Vzduchotechnika',
    image: '/images/service-hvac.jpg',
    href: '/sluzby#vzduchotechnika',
    ariaLabel: 'Více o vzduchotechnice',
    points: [
      'Garance mikroklimatických podmínek',
      'Garance úzkých pásem tolerance mikroklimatických podmínek pro technologické procesy',
      'Přizpůsobení provozním režimům',
      'Rekuperace tepla a chladu',
    ],
  },
  {
    id: 'topne-zdroje',
    title: 'Topné zdroje',
    image: '/images/service-heating.jpg',
    href: '/sluzby#topne-zdroje',
    ariaLabel: 'Více o topných zdrojích',
    points: [
      'Alternativní zdroje tepla',
      'Provozní náklady',
      'Rekuperace tepla',
      'Výpočty spotřeb tepla dle norem',
    ],
  },
  {
    id: 'chlazeni',
    title: 'Chlazení',
    image: '/images/service-cooling.png',
    href: '/sluzby#chlazeni',
    ariaLabel: 'Více o chlazení',
    points: [
      'Použití chladiv s nízkým koeficientem GWP (vliv chladiva na ozónovou díru)',
      'Provozní náklady',
      'Rekuperace a akumulace chladu',
      'Studie vhodnosti použití způsobu chlazení jednotlivých aplikacích',
    ],
  },
  {
    id: 'fotovoltaika',
    title: 'Fotovoltaika',
    image: '/images/service-solar.png',
    href: '/sluzby#fotovoltaika',
    ariaLabel: 'Více o fotovoltaice',
    points: [
      'Analýza trendů',
      'Servisní činnost',
      'Ukládání energie do baterek, sdílení energie',
      'Volba velikosti FVE s ohledem na návratnost',
    ],
  },
];
---

<div class="service-stack">
  {
    services.map((service, index) => (
      <article
        class="service-stack-item grid grid-cols-1 sm:grid-cols-[200px_1fr] lg:grid-cols-[auto_200px_1fr_auto] gap-4 sm:gap-6 items-center border border-gray-100 bg-white p-4 shadow-sm sm:p-6 lg:p-8"
        style={`z-index: ${index + 1};`}
      >
        <img
          src="/icons/service-icon.png"
          alt=""
          class="hidden h-10 w-10 object-contain lg:block"
          aria-hidden="true"
        />
        <a
          href={service.href}
          class="service-media block shrink-0 sm:row-span-2 lg:row-span-1"
          aria-label={service.ariaLabel}
        >
          <img
            src={service.image}
            alt={service.title}
            class="h-[160px] w-full object-cover sm:h-full sm:min-h-[120px] sm:w-[200px] lg:h-[120px]"
          />
        </a>
        <div class="space-y-3">
          <h3 class="text-xl font-semibold text-navy lg:text-[28px]">{service.title}</h3>
          <ul class="space-y-2 text-base font-medium text-navy/90 lg:text-[23px]">
            {service.points.map((point) => (
              <li class="flex items-start gap-2">
                <img src="/icons/check.svg" alt="" class="mt-2 shrink-0" width="15" height="10" />
                {point}
              </li>
            ))}
          </ul>
        </div>
        <a
          href={service.href}
          class="btn-flip btn-flip--icon-only btn-gradient-icon justify-self-end rounded-lg sm:col-start-2 lg:col-start-auto"
          aria-label={service.ariaLabel}
        >
          <span class="btn-flip-track">
            <span class="btn-flip-item">
              <img src="/icons/arrow.svg" alt="" class="h-3 w-4" />
            </span>
            <span class="btn-flip-item" aria-hidden="true">
              <img src="/icons/arrow.svg" alt="" class="h-3 w-4" />
            </span>
          </span>
        </a>
      </article>
    ))
  }
</div>
