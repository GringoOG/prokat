---
const services = [
  {
    id: 'chlazeni',
    title: 'Chlazení',
    image: '/images/service-cooling.png',
    href: '/sluzby#chlazeni',
    ariaLabel: 'Více o chlazení',
    points: [
      'Studie vhodnosti použití způsobu chlazení jednotlivých aplikacích',
      'Provozní náklady',
      'Rekuperace a akumulace chladu',
      'Použití chladiv s nízkým koeficientem GWP (vliv chladiva na ozónovou díru)',
    ],
  },
  {
    id: 'fotovoltaika',
    title: 'Fotovoltaika',
    image: '/images/service-solar.png',
    href: '/sluzby#fotovoltaika',
    ariaLabel: 'Více o fotovoltaice',
    points: [
      'Volba velikosti FVE s ohledem na návratnost',
      'Ukládání energie do baterek, sdílení energie',
      'Analýza trendů',
      'Servisní činnost',
    ],
  },
  {
    id: 'topne-zdroje',
    title: 'Topné zdroje',
    image: '/images/service-heating.jpg',
    href: '/sluzby#topne-zdroje',
    ariaLabel: 'Více o topných zdrojích',
    points: [
      'Výpočty spotřeb tepla dle norem',
      'Provozní náklady',
      'Alternativní zdroje tepla',
      'Rekuperace tepla',
    ],
  },
  {
    id: 'vzduchotechnika',
    title: 'Vzduchotechnika',
    image: '/images/service-hvac.jpg',
    href: '/sluzby#vzduchotechnika',
    ariaLabel: 'Více o vzduchotechnice',
    points: [
      'Garance mikroklimatických podmínek',
      'Přizpůsobení provozním režimům',
      'Rekuperace tepla a chladu',
      'Garance úzkých pásem tolerance mikroklimatických podmínek pro technologické procesy',
    ],
  },
];
---

<div class="bg-white rounded-3xl shadow-sm overflow-hidden border border-gray-100">
  {
    services.map((service, index) => (
      <article
        class:list={[
          'grid grid-cols-1 sm:grid-cols-[200px_1fr] lg:grid-cols-[auto_200px_1fr_auto] gap-4 sm:gap-6 items-center p-4 sm:p-6 lg:p-8 hover:bg-gray-50/50 transition-colors',
          index < services.length - 1 && 'border-b border-gray-100',
        ]}
      >
        <img
          src="/icons/service-icon.png"
          alt=""
          class="h-10 w-10 object-contain hidden lg:block"
          aria-hidden="true"
        />
        <a
          href={service.href}
          class="block rounded-xl overflow-hidden shrink-0 sm:row-span-2 lg:row-span-1 hover:opacity-90 transition-opacity"
          aria-label={service.ariaLabel}
        >
          <img
            src={service.image}
            alt={service.title}
            class="rounded-xl w-full sm:w-[200px] h-[160px] sm:h-full sm:min-h-[120px] lg:h-[120px] object-cover"
          />
        </a>
        <div class="space-y-3">
          <h3 class="text-xl lg:text-[28px] font-semibold text-navy">{service.title}</h3>
          <ul class="space-y-2 text-base lg:text-[23px] font-medium text-navy/90">
            {service.points.map((point) => (
              <li class="flex items-start gap-2">
                <img src="/icons/check.svg" alt="" class="mt-2 shrink-0" width="15" height="10" />
                {point}
              </li>
            ))}
          </ul>
        </div>
        <a
          href={service.href}
          class="btn-gradient-icon flex h-12 w-12 items-center justify-center rounded-lg shrink-0 justify-self-end sm:col-start-2 lg:col-start-auto"
          aria-label={service.ariaLabel}
        >
          <img src="/icons/arrow.svg" alt="" class="h-3 w-4" />
        </a>
      </article>
    ))
  }
</div>
