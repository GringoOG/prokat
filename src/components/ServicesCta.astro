---
import FlipButton from './FlipButton.astro';
---

<section class="mx-auto max-w-[1200px] px-6 py-12 lg:px-10 lg:py-16">
  <div class="relative overflow-hidden rounded-2xl bg-navy">
    <img
      src="/images/banner-bg-blue.jpg"
      alt=""
      class="pointer-events-none absolute inset-0 h-full w-full object-cover"
      aria-hidden="true"
    />
    <div
      class="relative flex flex-col items-start justify-between gap-6 px-7 py-7 sm:px-8 sm:py-8 lg:flex-row lg:items-center lg:gap-10 lg:px-10 lg:py-9"
    >
      <h2
        class="max-w-[22rem] text-2xl font-semibold leading-snug text-white sm:text-[28px] lg:max-w-md lg:text-[32px]"
      >
        Jste připraveni zahájit projekt?
      </h2>
      <FlipButton
        href="/kontakt"
        label="Naplánujte si konzultaci hned teď."
        variant="white"
        class="w-full shrink-0 sm:w-auto"
        iconClass="btn-gradient-icon flex h-10 w-10 shrink-0 items-center justify-center rounded-tl rounded-tr rounded-br-[10px] rounded-bl"
      />
    </div>
  </div>
</section>
