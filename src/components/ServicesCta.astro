---
import FlipButton from './FlipButton.astro';
---

<section class="services-watermark py-6 lg:py-8">
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-10">
    <div class="cta-banner-panel relative overflow-hidden rounded-lg">
      <div
        class="relative flex flex-col items-start justify-between gap-4 px-5 py-5 sm:gap-5 sm:px-8 sm:py-6 lg:flex-row lg:items-center lg:gap-10 lg:px-10 lg:py-6"
      >
        <h2
          class="max-w-none text-lg font-semibold leading-snug text-white sm:max-w-[22rem] sm:text-xl lg:max-w-md lg:text-[22px]"
        >
          Jste připraveni zahájit projekt?
        </h2>
        <FlipButton
          href="/kontakt"
          label="Naplánujte si konzultaci hned teď."
          class="w-full max-w-full sm:w-auto lg:self-center"
          iconClass="btn-gradient-icon btn-shape-icon flex h-10 w-10 shrink-0 items-center justify-center"
        />
      </div>
    </div>
  </div>
</section>
