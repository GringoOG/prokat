---
import SeoLabel from './SeoLabel.astro';

const faqs = [
  {
    question: 'Jaké realizační služby zajišťujete?',
    answer:
      'Specializujeme se na stavbu tepelných zdrojů, kotelen, FVE, vzduchotechniku a chlazení – od projektu až po samotnou realizaci.',
    open: true,
  },
  {
    question: 'Zajišťujete projekt i samotnou montáž, nebo musím mít vlastní plány?',
    answer:
      'Zajišťujeme kompletní servis včetně projektové dokumentace, realizace i montáže. Pokud máte vlastní plány, dokážeme je také zpracovat a realizovat.',
  },
  {
    question: 'Na jaké typy technologií se specializujete?',
    answer:
      'Vzduchotechniku, topné zdroje všech typů, průmyslové chlazení včetně přírodních chladiv a fotovoltaické systémy s AI monitoringem.',
  },
  {
    question: 'Jaká je životnost a servis vámi instalovaných systémů?',
    answer:
      'Poskytujeme záruční i pozáruční servis a vzdálený dohled nad zařízeními. Životnost závisí na typu technologie — u každého projektu garantujeme servisní podporu po celou dobu provozu.',
  },
  {
    question: 'Pomůžete nám i s úsporou energií a dotacemi?',
    answer:
      'Ano. Připravíme studii energetické hospodárnosti, navrhneme úsporná řešení s AI managementem a poradíme s dotačními tituly pro FVE i další technologie.',
  },
];
---

<section class="services-watermark relative pb-16 pt-6 lg:pb-20 lg:pt-8">
  <div class="relative mx-auto max-w-site px-6 lg:px-[28px]">
    <div class="mb-10 text-center lg:mb-14">
      <SeoLabel class="mx-auto mb-5">Časté dotazy</SeoLabel>
      <h2
        class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.2]"
      >
        Často kladené dotazy
      </h2>
    </div>

    <div class="faq-frame mx-auto w-full max-w-2xl rounded-2xl p-3 sm:p-4">
      <div class="space-y-3">
        {
          faqs.map((faq) => (
            <details
              class="faq-item group w-full overflow-hidden rounded-[14px] bg-white shadow-[0_8px_30px_rgba(16,16,41,0.08)]"
              open={faq.open}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-4 sm:gap-5 sm:p-5 lg:gap-6 lg:p-5 [&::-webkit-details-marker]:hidden">
                <span class="text-left text-sm font-semibold text-navy sm:text-base lg:text-lg">
                  {faq.question}
                </span>
                <span
                  class="faq-icon flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold text-xl font-light leading-none text-white"
                  aria-hidden="true"
                >
                  +
                </span>
              </summary>
              <div class="-mt-1 px-4 pb-4 sm:px-5 sm:pb-5 lg:px-5 lg:pb-5">
                <p class="text-base font-medium leading-relaxed text-navy/70">{faq.answer}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>
