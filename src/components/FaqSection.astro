---
import SeoLabel from './SeoLabel.astro';

const faqs = [
  {
    question: 'Jaké realizační služby zajišťujete?',
    answer:
      'Specializujeme se na stavbu tepelných zdrojů, kotelen, FVE, vzduchotechniku a chlazení – od projektu až po samotnou realizaci.',
    open: true,
  },
  {
    question: 'Zajišťujete projekt i samotnou montáž, nebo musím mít vlastní plány?',
    answer:
      'Zajišťujeme kompletní servis včetně projektové dokumentace, realizace i montáže. Pokud máte vlastní plány, dokážeme je také zpracovat a realizovat.',
  },
  {
    question: 'Na jaké typy technologií se specializujete?',
    answer:
      'Vzduchotechniku, topné zdroje všech typů, průmyslové chlazení včetně přírodních chladiv a fotovoltaické systémy s AI monitoringem.',
  },
  {
    question: 'Jaká je životnost a servis vámi instalovaných systémů?',
    answer:
      'Poskytujeme záruční i pozáruční servis a vzdálený dohled nad zařízeními. Životnost závisí na typu technologie — u každého projektu garantujeme servisní podporu po celou dobu provozu.',
  },
  {
    question: 'Pomůžete nám i s úsporou energií a dotacemi?',
    answer:
      'Ano. Připravíme studii energetické hospodárnosti, navrhneme úsporná řešení s AI managementem a poradíme s dotačními tituly pro FVE i další technologie.',
  },
];
---

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-site px-6 lg:px-10">
    <div class="mb-12 text-center">
      <SeoLabel class="mx-auto mb-4">FAQ</SeoLabel>
      <h2 class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.25]">
        Často kladené dotazy
      </h2>
    </div>

    <div class="mx-auto max-w-3xl space-y-3">
      {
        faqs.map((faq) => (
          <details class="faq-item group overflow-hidden rounded-2xl border border-gray-100 bg-white" open={faq.open}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 sm:gap-4 sm:p-6 lg:p-8 [&::-webkit-details-marker]:hidden">
              <span class="text-left text-sm font-semibold text-navy sm:text-base lg:text-xl">{faq.question}</span>
              <span
                class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xl font-light leading-none text-gold"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="-mt-2 px-4 pb-4 sm:px-6 sm:pb-6 lg:px-8 lg:pb-8">
              <p class="text-base font-medium leading-relaxed text-navy/70 lg:text-lg">{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-icon {
    transition: transform 0.2s ease;
  }
</style>
