---
import FlipButton from './FlipButton.astro';

interface Props {
  /** Světlé pozadí místo průhledného — video/hero neprosvítá skrz navigaci */
  solidBackground?: boolean;
}

const { solidBackground = false } = Astro.props;
const pathname = Astro.url.pathname;

const navItems = [
  { href: '/', label: 'Domů' },
  { href: '/o-nas', label: 'O nás' },
  { href: '/sluzby', label: 'Služby' },
  { href: '/projekty', label: 'Projekty' },
  { href: '/kontakt', label: 'Kontakt' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  id="site-header"
  class:list={[
    'site-header fixed inset-x-0 top-0 z-50 w-full transition-transform duration-300 ease-out pt-[env(safe-area-inset-top,0px)]',
    solidBackground
      ? 'nav-solid'
      : 'mobile-nav-gradient',
  ]}
>
  <div class="mx-auto max-w-site px-6 lg:px-[28px]">
    <nav class="relative flex min-h-[56px] items-center lg:min-h-0 lg:justify-between lg:py-3" aria-label="Hlavní navigace">
      <a
        href="/"
        class="group absolute left-1/2 z-10 -translate-x-1/2 lg:static lg:translate-x-0 lg:shrink-0"
      >
        <img
          src="/images/logo.png"
          alt="PROKAT invest"
          class="h-10 w-auto max-w-[min(48vw,210px)] origin-center object-contain transition-transform duration-300 ease-out group-hover:scale-105 sm:h-11 sm:max-w-none lg:h-14 lg:origin-left"
          width="322"
          height="80"
        />
      </a>

      <ul class="hidden items-center gap-5 text-base font-medium text-navy xl:gap-9 xl:text-[22px] lg:flex lg:text-lg">
        {
          navItems.map((item) => (
            <li>
              {isActive(item.href) ? (
                <a
                  href={item.href}
                  class="inline-flex items-center gap-2 text-gold transition-colors"
                  aria-current="page"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true" />
                  {item.label}
                </a>
              ) : (
                <a href={item.href} class="text-navy/80 transition-colors hover:text-gold">
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <div class="ml-auto flex items-center gap-3 lg:ml-0 lg:gap-5">
        <!-- Sídlo: only with desktop nav (hidden when burger menu shows) -->
        <div class="seat-reveal relative hidden lg:block">
          <button
            type="button"
            id="seat-toggle"
            class="flex h-10 w-10 items-center justify-center rounded-full bg-navy transition-opacity hover:opacity-90 sm:h-11 sm:w-11"
            aria-expanded="false"
            aria-controls="seat-panel"
            aria-label="Sídlo společnosti"
          >
            <svg class="h-4 w-4 text-gold" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.2 4.5 8.5 4.5 8.5s4.5-5.3 4.5-8.5A4.5 4.5 0 0 0 8 1.5Zm0 6.2a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4Z"
              ></path>
            </svg>
          </button>

          <div
            id="seat-panel"
            class="seat-panel pointer-events-none invisible absolute right-0 top-full z-40 w-[min(100vw-1.5rem,340px)] max-w-[calc(100vw-1.5rem)] pt-3 opacity-0 transition-all duration-150"
            role="region"
            aria-label="Sídlo společnosti"
          >
            <address
              class="seat-panel-inner relative block select-text not-italic overflow-hidden rounded-2xl border border-navy/10 bg-white p-5 shadow-lg sm:p-6"
            >
              <span
                class="pointer-events-none absolute inset-y-0 left-0 w-1.5 bg-gradient-to-b from-navy via-gold to-[#8e6b33]"
                aria-hidden="true"
              ></span>

              <p class="mb-3 text-sm font-medium text-gold">Sídlo společnosti</p>

              <div class="space-y-0.5 text-[15px] font-medium leading-relaxed text-navy">
                <p class="font-semibold">PROKAT invest s.r.o.</p>
                <p>Plzeňská 1348/95</p>
                <p>Praha 5</p>
                <p class="pt-2">IČ: 25238876</p>
                <p>DIČ: CZ25238876</p>
              </div>

              <div class="my-4 h-px bg-gray-200"></div>

              <div class="space-y-0.5 text-[15px] font-medium leading-relaxed text-navy">
                <p>Datová schránka: ns3u7ke</p>
                <p>Společnost je zapsaná v obchodním rejstříku:</p>
                <p class="font-semibold">Městský soud v Praze, oddíl C, vložka 350481.</p>
              </div>
            </address>
          </div>
        </div>

        <div class="hidden shrink-0 lg:block">
          <FlipButton
            href="/kontakt"
            label="Získejte CN"
            class="inline-flex !min-h-[34px] text-sm font-medium xl:!min-h-[40px] xl:text-lg"
            labelClass="btn-flip-label !py-1.5 !pl-3 !pr-1 xl:!pl-4"
            iconClass="btn-gradient-icon btn-shape-icon flex h-[25px] w-[25px] shrink-0 items-center justify-center xl:h-8 xl:w-8"
          />
        </div>

        <button
          type="button"
          id="menu-toggle"
          class="menu-toggle flex h-10 w-10 flex-col items-center justify-center gap-[5px] rounded-lg bg-navy/95 p-2 lg:hidden"
          aria-label="Otevřít menu"
          aria-expanded="false"
        >
          <span class="menu-bar block h-[2px] w-5 rounded-full bg-white transition-transform duration-200"></span>
          <span class="menu-bar block h-[2px] w-5 rounded-full bg-white transition-transform duration-200"></span>
        </button>
      </div>
    </nav>

    <div id="mobile-menu" class="hidden border-t border-white/15 pb-6 lg:hidden">
      <ul class="flex flex-col gap-4 pt-4 text-lg font-medium text-white/90">
        {
          navItems.map((item) => (
            <li>
              {isActive(item.href) ? (
                <a
                  href={item.href}
                  class="mobile-nav-link inline-flex items-center gap-2 text-gold transition-colors"
                  aria-current="page"
                >
                  <span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true" />
                  {item.label}
                </a>
              ) : (
                <a href={item.href} class="mobile-nav-link transition-colors hover:text-gold">
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>

      <details class="mobile-seat mt-5 rounded-xl border border-white/15 bg-white/5 px-4 py-3 text-white/90">
        <summary class="cursor-pointer list-none text-sm font-semibold text-gold [&::-webkit-details-marker]:hidden">
          Sídlo společnosti
        </summary>
        <address class="mt-3 space-y-0.5 text-sm font-medium not-italic leading-relaxed text-white/85">
          <p class="font-semibold text-white">PROKAT invest s.r.o.</p>
          <p>Plzeňská 1348/95, Praha 5</p>
          <p>IČ: 25238876 · DIČ: CZ25238876</p>
          <p class="pt-1">Datová schránka: ns3u7ke</p>
        </address>
      </details>

      <div class="mt-6 flex justify-start">
        <FlipButton
          href="/kontakt"
          label="Získejte CN"
          class="inline-flex w-full max-w-xs !min-h-[40px] justify-center text-sm font-medium text-white sm:w-auto"
          labelClass="btn-flip-label !py-1.5 !pl-3 !pr-1"
          iconClass="btn-gradient-icon btn-shape-icon flex h-[25px] w-[25px] shrink-0 items-center justify-center"
        />
      </div>
    </div>
  </div>
</header>
<div id="site-header-spacer" class="site-header-spacer" aria-hidden="true"></div>

<style>
  .nav-solid {
    background-color: #f6f6f6;
    background-image: url('/images/pozadi-prokat-v3.webp');
    background-size: 100% auto;
    background-position: center top;
    background-repeat: no-repeat;
  }

  .mobile-nav-gradient {
    background: linear-gradient(
      90deg,
      #101029 0%,
      #15101c 14%,
      #3d2e1a 32%,
      #d49d39 50%,
      #3d2e1a 68%,
      #15101c 86%,
      #101029 100%
    );
  }

  @media (min-width: 1024px) {
    .mobile-nav-gradient {
      background-color: rgba(246, 246, 246, 0.96);
      backdrop-filter: blur(6px);
    }
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .menu-toggle.is-open .menu-bar:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .menu-toggle.is-open .menu-bar:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header {
      transition: none;
    }

    .menu-bar {
      transition: none;
    }
  }

  .seat-panel {
    transform: translateY(4px);
  }

  .seat-reveal.is-open .seat-panel,
  .seat-reveal:focus-within .seat-panel {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: hover) and (pointer: fine) {
    .seat-reveal:hover .seat-panel {
      pointer-events: auto;
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const spacer = document.getElementById('site-header-spacer');
  let lastScrollY = window.scrollY;
  let scrollTicking = false;

  const syncHeaderSpacer = () => {
    if (!header || !spacer) return;
    spacer.style.height = `${header.offsetHeight}px`;
  };

  syncHeaderSpacer();
  window.addEventListener('resize', syncHeaderSpacer);
  if (document.fonts?.ready) {
    document.fonts.ready.then(syncHeaderSpacer);
  }

  const updateHeaderOnScroll = () => {
    if (!header) return;

    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;

    if (currentScrollY <= 8) {
      header.classList.remove('is-hidden');
    } else if (delta > 6) {
      header.classList.add('is-hidden');
    } else if (delta < -6) {
      header.classList.remove('is-hidden');
    }

    lastScrollY = currentScrollY;
    scrollTicking = false;
  };

  window.addEventListener(
    'scroll',
    () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(updateHeaderOnScroll);
    },
    { passive: true },
  );

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const setMobileMenuOpen = (open) => {
    if (!menu || !toggle) return;

    menu.classList.toggle('hidden', !open);
    toggle.classList.toggle('is-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
    document.body.classList.toggle('mobile-menu-open', open);
    requestAnimationFrame(syncHeaderSpacer);
  };

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.contains('hidden') ?? true;
    setMobileMenuOpen(isOpen);
  });

  menu?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => setMobileMenuOpen(false));
  });

  window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
    if (event.matches) setMobileMenuOpen(false);
  });

  const seatReveal = document.querySelector('.seat-reveal');
  const seatToggle = document.getElementById('seat-toggle');
  const seatPanel = document.getElementById('seat-panel');

  if (seatReveal instanceof HTMLElement && seatToggle instanceof HTMLButtonElement && seatPanel) {
    let closeTimer = 0;

    const setOpen = (open) => {
      window.clearTimeout(closeTimer);
      seatReveal.classList.toggle('is-open', open);
      seatToggle.setAttribute('aria-expanded', String(open));
    };

    const scheduleClose = () => {
      window.clearTimeout(closeTimer);
      closeTimer = window.setTimeout(() => setOpen(false), 280);
    };

    seatReveal.addEventListener('mouseenter', () => setOpen(true));
    seatReveal.addEventListener('mouseleave', scheduleClose);

    seatToggle.addEventListener('click', (event) => {
      event.stopPropagation();
      setOpen(!seatReveal.classList.contains('is-open'));
    });

    seatPanel.addEventListener('mousedown', () => setOpen(true));

    document.addEventListener('click', (event) => {
      if (!seatReveal.contains(event.target)) setOpen(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  }
</script>
