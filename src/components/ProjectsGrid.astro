---
const visibleProjects = [
  {
    client: 'Škoda Auto',
    subtitle: 'Datové centrum',
    savings: '16%',
    image: '/images/projects/project-skoda.jpg',
    alt: 'Škoda Auto — datové centrum',
  },
  {
    client: 'Pilsner Urquel',
    subtitle: 'Odvětrávání CO2',
    image: '/images/projects/project-pilsner.jpg',
    alt: 'Pilsner Urquel — odvětrávání CO2',
  },
  {
    client: 'Letiště Václava Havla',
    subtitle: 'Strojovna chlazení',
    savings: '17%',
    image: '/images/projects/project-airport.jpg',
    alt: 'Letiště Václava Havla — strojovna chlazení',
  },
  {
    client: 'Hotel Marriott',
    subtitle: 'Chlazení, topení, VZT, TZB, rekonstrukce kotelny i pokojů',
    savings: '12%',
    image: '/images/projects/project-marriott.jpg',
    alt: 'Hotel Marriott',
  },
  {
    client: "King's Casino",
    subtitle: 'Chlazení, topení, VZT, TZB',
    savings: '15%',
    image: '/images/projects/project-casino.jpg',
    alt: "King's Casino",
  },
  {
    client: 'Hotel Epiq',
    subtitle: 'Zdroj tepla a chladu, VZT, RTCH, ZTI',
    savings: '19%',
    image: '/images/projects/project-epiq.jpg',
    alt: 'Hotel Epiq — zdroj tepla a chladu, VZT, RTCH, ZTI',
  },
];

const moreProjects = [
  {
    client: 'Košířská brána',
    subtitle: 'Chlazení, topení, VZT, TZB',
    savings: '17%',
    image: '/images/projects/project-kosirska.jpg',
    alt: 'Košířská brána',
  },
  {
    client: 'Lutz',
    subtitle: 'FVE — Čestlice, Plzeň, Letňany, Modřice, Liberec, Stodůlky',
    savings: '20%',
    image: '/images/projects/project-lutz.png',
    alt: 'Lutz — fotovoltaika',
  },
  {
    client: 'Möbelix Liberec',
    subtitle: 'FVE — Liberec',
    savings: '20%',
    image: '/images/projects/project-mobelix.png',
    alt: 'Möbelix Liberec — fotovoltaika',
  },
];

const projects = [...visibleProjects];
---

<div class="panel-gold-dark overflow-hidden rounded-2xl border border-gold/40 p-3 sm:p-6 lg:p-8">
  <div id="projects-grid" class="grid grid-cols-1 gap-3 sm:gap-4 lg:grid-cols-2 lg:gap-6">
    {
      projects.map((project) => (
        <article class="project-card group grid grid-cols-1 overflow-hidden rounded-xl bg-white sm:grid-cols-2">
          <div class="flex min-h-[180px] flex-col justify-center bg-white p-5 sm:min-h-[240px] sm:p-6 lg:p-8">
            <h2 class="text-lg font-semibold leading-snug text-gold sm:text-xl lg:text-2xl">{project.client}</h2>
            <p class="mt-2 text-sm font-medium leading-snug text-navy/70 lg:text-base">{project.subtitle}</p>
            {project.savings && (
              <div class="mt-4 lg:mt-6">
                <p class="text-3xl font-semibold leading-none text-navy lg:text-4xl">{project.savings}</p>
                <p class="mt-1 text-sm font-medium text-navy/60 lg:text-base">Úspora provozních nákladů</p>
              </div>
            )}
          </div>

          <div class="relative min-h-[220px] overflow-hidden bg-gray-100 sm:h-full sm:min-h-0">
            <img
              src={project.image}
              alt={project.alt}
              class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
              loading="lazy"
              decoding="async"
            />
            <div
              class="project-logo-overlay pointer-events-none absolute inset-0 flex items-center justify-center bg-black/45 p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
              aria-hidden="true"
            >
              <img
                src="/images/logo.png"
                alt=""
                class="h-10 w-auto drop-shadow-md sm:h-12 lg:h-14"
                width="322"
                height="80"
              />
            </div>
          </div>
        </article>
      ))
    }

    <div id="projects-more" class="contents hidden">
      {
        moreProjects.map((project) => (
          <article class="project-card group grid grid-cols-1 overflow-hidden rounded-xl bg-white sm:grid-cols-2">
            <div class="flex min-h-[180px] flex-col justify-center bg-white p-5 sm:min-h-[240px] sm:p-6 lg:p-8">
              <h2 class="text-lg font-semibold leading-snug text-gold sm:text-xl lg:text-2xl">{project.client}</h2>
              <p class="mt-2 text-sm font-medium leading-snug text-navy/70 lg:text-base">{project.subtitle}</p>
              {project.savings && (
                <div class="mt-4 lg:mt-6">
                  <p class="text-3xl font-semibold leading-none text-navy lg:text-4xl">{project.savings}</p>
                  <p class="mt-1 text-sm font-medium text-navy/60 lg:text-base">Úspora provozních nákladů</p>
                </div>
              )}
            </div>

            <div class="relative min-h-[220px] overflow-hidden bg-gray-100 sm:h-full sm:min-h-0">
              <img
                src={project.image}
                alt={project.alt}
                class="absolute inset-0 h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
                loading="lazy"
                decoding="async"
              />
              <div
                class="project-logo-overlay pointer-events-none absolute inset-0 flex items-center justify-center bg-black/45 p-4 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                aria-hidden="true"
              >
                <img
                  src="/images/logo.png"
                  alt=""
                  class="h-10 w-auto drop-shadow-md sm:h-12 lg:h-14"
                  width="322"
                  height="80"
                />
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="mt-8 flex flex-col items-center gap-5">
    <p id="projects-coming-soon" class="hidden text-center text-base font-semibold leading-none text-gold lg:text-lg">
      Již brzy více referencí …
    </p>
    <button
      id="projects-show-more"
      type="button"
      class="btn-shape inline-flex h-10 items-center justify-center bg-gold px-7 text-sm font-semibold leading-none text-white transition-colors hover:bg-[#c48d2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:ring-offset-2 focus-visible:ring-offset-[#15101c]"
    >
      Zobrazit více
    </button>
    <button
      id="projects-show-less"
      type="button"
      class="btn-shape hidden inline-flex h-10 items-center justify-center bg-gold px-7 text-sm font-semibold leading-none text-white transition-colors hover:bg-[#c48d2f] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60 focus-visible:ring-offset-2 focus-visible:ring-offset-[#15101c]"
    >
      Zobrazit méně
    </button>
  </div>
</div>

<script>
  const showMoreBtn = document.getElementById('projects-show-more');
  const showLessBtn = document.getElementById('projects-show-less');
  const moreProjectsEl = document.getElementById('projects-more');
  const comingSoon = document.getElementById('projects-coming-soon');

  showMoreBtn?.addEventListener('click', () => {
    moreProjectsEl?.classList.remove('hidden');
    showMoreBtn.classList.add('hidden');
    showLessBtn?.classList.remove('hidden');
    comingSoon?.classList.remove('hidden');
  });

  showLessBtn?.addEventListener('click', () => {
    moreProjectsEl?.classList.add('hidden');
    showLessBtn.classList.add('hidden');
    comingSoon?.classList.add('hidden');
    showMoreBtn?.classList.remove('hidden');
    document.getElementById('projects-grid')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>

<style>
  @media (hover: none) {
    .project-card:active .project-logo-overlay {
      opacity: 1;
    }
  }
</style>
