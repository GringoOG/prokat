---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ServicesCta from '../components/ServicesCta.astro';
import FaqSection from '../components/FaqSection.astro';
---

<Layout
  title="Služby | Prokat Invest"
  description="Naše služby — vzduchotechnika, topné zdroje, chlazení a fotovoltaika. Kompletní realizace od projektu po servis."
>
  <div class="services-watermark relative">
    <Navbar />

    <section class="pb-8 pt-12 lg:pb-10 lg:pt-40">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <h1 class="mb-10 text-center text-3xl font-semibold leading-snug tracking-tight text-navy sm:mb-12 sm:text-4xl lg:mb-16 lg:text-[58px] lg:leading-[1.25]">
          Naše služby
        </h1>

        <ServicesGrid />
      </div>
    </section>
  </div>

  <main>
    <ServicesCta />
    <FaqSection />
  </main>

  <Footer />
</Layout>
