---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FlipButton from '../components/FlipButton.astro';

const competencies = [
  { title: 'Vzduchotechnika', href: '/sluzby/vzduchotechnika' },
  { title: 'Topné zdroje', href: '/sluzby/topne-zdroje' },
  { title: 'Chlazení', href: '/sluzby/chlazeni' },
  { title: 'Fotovoltaika', href: '/sluzby/fotovoltaika' },
];
---

<Layout
  title="O nás | Prokat Invest"
  description="PROKAT invest — 25 let špičkových realizací v oblasti vzduchotechniky, vytápění, chlazení a ZTI od roku 1999."
>
  <div class="section-watermark bg-surface relative">
    <Navbar />

    <section class="pb-12 pt-8 lg:pb-16 lg:pt-28">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <div class="text-center">
          <h1 class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.2]">
            O nás
          </h1>
          <p class="mt-2 text-lg font-medium leading-snug text-navy/80 md:text-[23px]">
            Plzeňská 1348/95, 150 00 Praha 5
          </p>
        </div>

        <p
          class="mt-8 max-w-md text-left text-xl font-semibold leading-snug tracking-tight text-navy sm:text-2xl lg:mt-10 lg:text-[42px] lg:leading-[1.2]"
        >
          <span class="text-gold">25 let</span> špičkových<br />
          realizací a uznání
        </p>
      </div>
    </section>
  </div>

  <main>
    <section class="overflow-hidden bg-white">
      <div class="relative grid grid-cols-1 lg:grid-cols-2">
        <div class="overflow-hidden">
          <img
            src="/images/about-building.jpg"
            alt="Budova PROKAT invest"
            class="h-full w-full min-h-[300px] object-cover lg:min-h-[520px]"
            width="980"
            height="551"
            loading="eager"
          />
        </div>

        <div class="relative flex min-h-[360px] items-center overflow-hidden bg-navy lg:min-h-[520px]">
          <div
            class="pointer-events-none absolute inset-y-0 left-0 z-[1] w-28 bg-gradient-to-r from-gold/80 via-gold/25 to-transparent sm:w-36 lg:w-44"
            aria-hidden="true"
          ></div>
          <img
            src="/images/about-since-bg.png"
            alt=""
            class="pointer-events-none absolute inset-0 z-[2] h-full w-full object-cover opacity-[0.08]"
            aria-hidden="true"
          />

          <div class="relative z-10 space-y-4 px-8 py-14 pb-28 text-base font-medium leading-relaxed text-white sm:px-10 lg:px-14 lg:py-16 lg:pb-32 lg:text-lg">
            <p>
              Realizujeme technologické celky včetně studie energetické hospodárnosti, projektu, realizace,
              záručního a pozáručního servisu včetně vzdáleného monitoringu.
            </p>
            <p>
              Společnost je držitelem certifikátu <strong>CRIF Business Elite</strong> — skvěle řízená společnost
              a záruka finanční stability a spolehlivého partnerství.
            </p>
          </div>

          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 overflow-hidden" aria-hidden="true">
            <div class="since-marquee-track flex w-max items-center">
              {
                Array.from({ length: 2 }).map(() => (
                  <p class="since-marquee-text">
                    SINCE - 1999 &nbsp; SINCE - 1999 &nbsp; SINCE - 1999 &nbsp; SINCE - 1999 &nbsp;
                  </p>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="services-watermark bg-surface py-16 lg:py-24">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <p
          class="mx-auto mb-8 inline-flex w-fit items-center gap-2.5 rounded-full border border-gray-300 bg-white/80 px-4 py-2 text-sm font-medium text-navy md:text-base lg:mx-0"
        >
          <span class="h-2 w-2 shrink-0 rounded-[2px] bg-gold" aria-hidden="true"></span>
          Naše cesta
        </p>

        <h2
          class="mb-12 max-w-4xl text-center text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:mb-16 lg:text-left lg:text-[58px] lg:leading-[1.25]"
        >
          Budujeme důvěru a kvalitu na základech <span class="text-gold">dlouholetých</span> inženýrských
          zkušeností.
        </h2>

        <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(340px,440px)] lg:gap-14 xl:gap-20">
          <div class="order-2 space-y-10 lg:order-1">
            <div class="grid grid-cols-1 items-start gap-10 sm:grid-cols-[minmax(0,240px)_1fr] sm:gap-8 lg:gap-10">
              <div class="relative mx-auto w-full max-w-[240px] overflow-hidden rounded-2xl sm:mx-0 sm:max-w-none">
                <img
                  src="/images/about-director.png"
                  alt="Ing. Vladimír Škrlant"
                  class="aspect-[305/420] w-full object-cover"
                  width="305"
                  height="420"
                />
                <div
                  class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 via-black/45 to-transparent px-5 pb-5 pt-14"
                >
                  <p class="text-sm font-medium text-white/90">Ing. Vladimír Škrlant</p>
                  <p class="mt-1 text-lg font-semibold leading-snug text-white sm:text-xl">
                    Majitel &amp; ředitel
                  </p>
                </div>
              </div>

              <div>
                <h3 class="mb-4 text-xl font-semibold text-navy lg:text-2xl">Náš příběh</h3>
                <div class="space-y-4 text-base leading-relaxed text-navy/80 lg:text-lg">
                  <p>
                    Začínali jsme jako tým technických specialistů s jasným cílem — dodávat spolehlivá a efektivní
                    řešení v oblasti vzduchotechniky, vytápění a chlazení. Postupně jsme rozšířili portfolio o
                    komplexní služby včetně měření, regulace a fotovoltaiky.
                  </p>
                  <p>
                    Dnes jsme stabilním partnerem pro průmyslové i komerční projekty po celé České republice. Naším
                    cílem zůstává kvalita realizace, dlouhodobá spolupráce a provozní úspory pro každého zákazníka.
                  </p>
                </div>
              </div>
            </div>

            <div class="flex flex-col">
              <h3 class="mb-4 text-xl font-semibold text-navy lg:text-2xl">Naše odborné kompetence</h3>
              <ul class="mb-8 divide-y divide-gray-200 border-t border-gray-200">
                {
                  competencies.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="group flex items-center justify-between gap-4 py-4 text-base font-medium text-navy transition-colors hover:text-gold lg:text-lg"
                      >
                        <span>{item.title}</span>
                        <svg
                          class="h-3 w-4 shrink-0 text-gold transition-transform group-hover:translate-x-0.5"
                          viewBox="0 0 16 12"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                          aria-hidden="true"
                        >
                          <path
                            d="m14.425 6-5-5m5 5-5 5m5-5H1.575"
                            stroke="currentColor"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="1.5"
                          ></path>
                        </svg>
                      </a>
                    </li>
                  ))
                }
              </ul>

              <FlipButton
                href="/projekty"
                label="Zobrazit naše realizace."
                class="mt-auto w-full sm:w-auto"
              />
            </div>
          </div>

          <figure class="order-1 mx-auto w-full max-w-[440px] lg:order-2 lg:sticky lg:top-28 lg:mx-0 lg:max-w-none">
            <img
              src="/images/crif-business-elite-cz.png"
              alt="CRIF Business Elite 2026 — Certifikát PROKAT invest s.r.o."
              class="h-auto w-full object-contain shadow-lg"
              width="849"
              height="1200"
              loading="lazy"
            />
            <figcaption class="mt-4 text-center text-sm font-medium text-navy/60 lg:text-left">
              CRIF Business Elite 2026
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
