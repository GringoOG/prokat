---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FlipButton from '../components/FlipButton.astro';
import SeoLabel from '../components/SeoLabel.astro';

const competencies = [
  { title: 'Vzduchotechnika', href: '/sluzby/vzduchotechnika' },
  { title: 'Topné zdroje', href: '/sluzby/topne-zdroje' },
  { title: 'Chlazení', href: '/sluzby/chlazeni' },
  { title: 'Fotovoltaika', href: '/sluzby/fotovoltaika' },
];
---

<Layout
  title="O nás | Prokat Invest"
  description="PROKAT invest — 25 let špičkových realizací v oblasti vzduchotechniky, vytápění, chlazení a ZTI od roku 1999."
>
  <div class="section-watermark relative">
    <Navbar />

    <section class="pb-24 pt-12 lg:pb-[7.5rem] lg:pt-40">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <div class="text-center">
          <h1 class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.2]">
            O nás
          </h1>
          <p class="mt-2 text-lg font-medium leading-snug text-navy/80 md:text-[23px]">
            Plzeňská 1348/95, 150 00 Praha 5
          </p>
        </div>
      </div>
    </section>
  </div>

  <main>
    <section class="overflow-visible">
      <div class="relative grid grid-cols-1 lg:grid-cols-2">
        <div class="relative overflow-visible">
          <img
            src="/images/about-building.jpg"
            alt="Budova PROKAT invest"
            class="h-full w-full min-h-[300px] object-cover lg:min-h-[520px]"
            width="980"
            height="551"
            loading="eager"
          />
          <p
            class="absolute bottom-full left-6 z-20 max-w-md pb-0 text-left text-xl font-semibold leading-[1.15] tracking-tight text-navy sm:left-8 sm:text-2xl lg:left-[28px] lg:text-[42px]"
          >
            <span class="text-gold">25 let</span> špičkových<br />
            realizací a uznání
          </p>
        </div>

        <div class="relative flex min-h-[360px] flex-col overflow-hidden lg:min-h-[520px]">
          <div
            class="pointer-events-none absolute inset-0 z-0"
            style="background: linear-gradient(135deg, #d49d39 0%, #c4923a 10%, #8e6b33 24%, #3d2e1a 45%, #1a1528 65%, #101029 100%);"
            aria-hidden="true"
          ></div>

          <div
            class="relative z-10 flex flex-1 flex-col px-8 pb-24 pt-10 sm:px-10 lg:px-14 lg:pb-28 lg:pt-12"
          >
            <div class="space-y-4 text-base font-medium leading-relaxed text-white lg:text-lg">
              <p>
                Realizujeme technologické celky včetně studie energetické hospodárnosti, projektu, realizace,
                záručního a pozáručního servisu včetně vzdáleného monitoringu.
              </p>
              <p>
                <strong>PROKAT invest</strong> je držitelem skóringového hodnocení Czech Stability Award AAA Excellent a
                držitelem certifikátu <strong>CRIF Business Elite</strong> v roce 2026 — skvěle řízená společnost,
                záruka finanční stability a spolehlivého partnerství, na jejichž základě se řadíme mezi nejstabilnější
                firmy v České republice v rámci hodnocení CZECH TOP 100.
              </p>
            </div>

            <div
              class="mt-8 flex items-center justify-center gap-5 sm:mt-9 sm:gap-6 lg:mt-10 lg:gap-8"
            >
              <img
                src="/images/czech-stability-award-bw.png"
                alt=""
                width="270"
                height="367"
                aria-hidden="true"
                decoding="async"
                class="pointer-events-none h-auto w-[62px] max-w-[38%] select-none bg-transparent sm:w-[76px] lg:w-[90px]"
              />
              <img
                src="/images/crif-elite-badge.png"
                alt=""
                width="140"
                height="102"
                aria-hidden="true"
                decoding="async"
                class="pointer-events-none h-auto w-[104px] max-w-[48%] select-none bg-transparent brightness-0 invert sm:w-[130px] lg:w-[154px]"
              />
            </div>
          </div>

          <div class="pointer-events-none absolute inset-x-0 bottom-0 z-20 overflow-hidden" aria-hidden="true">
            <div class="since-marquee-track flex w-max items-center">
              {
                Array.from({ length: 2 }).map(() => (
                  <p class="since-marquee-text">
                    -- Od roku 1999 -- Od roku 1999 -- Od roku 1999 -- Od roku 1999 --
                  </p>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="services-watermark py-16 lg:py-24">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <SeoLabel class="mx-auto mb-8 lg:mx-0">Naše cesta</SeoLabel>

        <h2
          class="mb-12 max-w-4xl text-center text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:mb-16 lg:text-left lg:text-[58px] lg:leading-[1.25]"
        >
          Budujeme důvěru a kvalitu na základech <span class="text-gold">dlouholetých</span> inženýrských
          zkušeností.
        </h2>

        <!-- Band 1: people + story -->
        <div
          class="mb-14 grid grid-cols-1 items-start gap-10 lg:mb-20 lg:grid-cols-[minmax(220px,280px)_minmax(0,1fr)] lg:gap-14 xl:gap-16"
        >
          <figure class="relative mx-auto w-full max-w-[280px] overflow-hidden rounded-2xl lg:mx-0 lg:max-w-none">
            <img
              src="/images/about-director.png"
              alt="Ing. Vladimír Škrlant"
              class="aspect-[305/420] w-full object-cover"
              width="305"
              height="420"
            />
            <figcaption
              class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy/85 via-navy/50 to-transparent px-5 pb-5 pt-16"
            >
              <p class="text-sm font-medium text-white/90">Ing. Vladimír Škrlant</p>
              <p class="mt-1 text-lg font-semibold leading-snug text-white sm:text-xl">
                Majitel &amp; ředitel
              </p>
            </figcaption>
          </figure>

          <div class="max-w-2xl lg:pt-2">
            <h3 class="mb-5 text-xl font-semibold text-navy lg:text-2xl">Náš příběh</h3>
            <div class="space-y-5 text-base leading-relaxed text-navy/80 lg:text-lg">
              <p>
                Začínali jsme jako tým technických specialistů s jasným cílem — dodávat spolehlivá a efektivní
                řešení v oblasti vzduchotechniky, vytápění a chlazení. Postupně jsme rozšířili portfolio o
                komplexní služby včetně měření, regulace a fotovoltaiky.
              </p>
              <p>
                Dnes jsme stabilním partnerem pro průmyslové i komerční projekty po celé České republice. Naším
                cílem zůstává kvalita realizace, dlouhodobá spolupráce a provozní úspory pro každého zákazníka.
              </p>
            </div>
          </div>
        </div>

        <!-- Band 2: competencies + certificate proof -->
        <div
          class="grid grid-cols-1 items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(260px,340px)] lg:gap-14 xl:gap-20"
        >
          <div>
            <h3 class="mb-5 text-xl font-semibold text-navy lg:text-2xl">Naše odborné kompetence</h3>
            <ul class="mb-8 divide-y divide-gray-200 border-y border-gray-200 sm:max-w-xl">
              {
                competencies.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class="group flex items-center justify-between gap-4 py-4 text-base font-medium text-navy transition-colors hover:text-gold lg:text-lg"
                    >
                      <span>{item.title}</span>
                      <svg
                        class="h-3 w-4 shrink-0 text-gold transition-transform group-hover:translate-x-0.5"
                        viewBox="0 0 16 12"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                        aria-hidden="true"
                      >
                        <path
                          d="m14.425 6-5-5m5 5-5 5m5-5H1.575"
                          stroke="currentColor"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="1.5"
                        ></path>
                      </svg>
                    </a>
                  </li>
                ))
              }
            </ul>

            <FlipButton href="/projekty" label="Zobrazit naše realizace." class="w-fit" />
          </div>

          <figure class="mx-auto w-full max-w-[320px] lg:mx-0 lg:max-w-none">
            <img
              src="/images/crif-business-elite-cz.png"
              alt="CRIF Business Elite 2026 — Certifikát PROKAT invest s.r.o."
              class="h-auto w-full bg-transparent object-contain"
              width="849"
              height="1200"
              loading="lazy"
            />
            <figcaption class="mt-3 text-center text-sm font-medium text-navy/55 lg:text-left">
              CRIF Business Elite 2026
            </figcaption>
          </figure>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
