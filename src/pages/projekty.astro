---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ProjectsGrid from '../components/ProjectsGrid.astro';
---

<Layout
  title="Projekty | Prokat Invest"
  description="Naše projekty — reference realizací pro Škoda Auto, Pilsner Urquell, Letiště Václava Havla, Hotel Marriott a další."
>
  <div class="section-watermark relative">
    <Navbar />

    <main>
      <section class="pb-16 pt-12 lg:pb-24 lg:pt-40">
        <div class="mx-auto max-w-site px-6 lg:px-[28px]">
          <h1 class="mb-10 text-center text-3xl font-semibold leading-snug tracking-tight text-navy sm:mb-12 sm:text-4xl lg:mb-16 lg:text-[58px] lg:leading-[1.25]">
            Naše projekty
          </h1>

          <ProjectsGrid />
        </div>
      </section>
    </main>
  </div>

  <Footer />
</Layout>
