---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ClientLogos from '../components/ClientLogos.astro';
import ContactCompanyInfo from '../components/ContactCompanyInfo.astro';
import ContactPersons from '../components/ContactPersons.astro';
---

<Layout
  title="Kontakt | Prokat Invest"
  description="Kontakty PROKAT invest s.r.o. — sídlo v Praze, provozní střediska a kompletní seznam kontaktních osob."
>
  <div class="contact-page relative">
    <Navbar />

    <main>
      <section class="pb-8 pt-12 lg:pb-16 lg:pt-40">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <h1 class="mb-10 text-center text-3xl font-semibold leading-snug tracking-tight text-navy sm:mb-12 sm:text-4xl lg:mb-16 lg:text-[58px] lg:leading-[1.25]">
          Kontakty
        </h1>

        <ContactCompanyInfo />
      </div>
    </section>

    <ContactPersons class="bg-transparent" />
    <ClientLogos />
    </main>
  </div>

  <Footer />
</Layout>
