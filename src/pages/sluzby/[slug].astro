---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FlipButton from '../../components/FlipButton.astro';
import SeoLabel from '../../components/SeoLabel.astro';
import { getServiceBySlug, processSteps, services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  throw new Error(`Unknown service slug: ${slug}`);
}
---

<Layout title={`${service.title} | Prokat Invest`} description={service.description}>
  <div class="services-watermark relative">
    <Navbar />

    <section class="pb-0 pt-12 lg:pt-40">
      <div class="mx-auto max-w-site px-6 text-center lg:px-[28px]">
        <h1
          class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.2]"
        >
          {service.title}
        </h1>
        <div class="mt-6 mb-8 flex justify-center sm:mt-8 sm:mb-10 lg:mb-14">
          <FlipButton href="/kontakt" label="Nezávazná nabídka zdarma." class="w-auto" />
        </div>
      </div>
    </section>
  </div>

  <main>
    <section class="services-watermark">
      <div class="mx-auto w-full max-w-[1600px]">
        <img
          src={service.image}
          alt={service.title}
          class="h-auto w-full object-cover object-center"
          width="1600"
          height="900"
          loading="eager"
          decoding="async"
        />
      </div>
    </section>

    <section class="services-watermark pt-8 pb-6 lg:pt-24 lg:pb-10">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <SeoLabel class="mb-6">Přehled služby</SeoLabel>
        <h2
          class="mb-6 text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[42px] lg:leading-[1.2]"
        >
          {service.overviewTitle}
        </h2>
        <div class="space-y-5 text-base font-medium leading-relaxed text-navy/80 lg:text-lg">
          {service.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="pt-6 pb-12 lg:pt-10 lg:pb-24">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <img
          src={service.heroImage}
          alt={`Schéma — ${service.title}`}
          class="mx-auto mb-8 h-auto w-full object-contain sm:mb-10 lg:mb-16"
          width="2400"
          height="1000"
          loading="lazy"
        />
        <div class="grid grid-cols-1 items-stretch gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
          {
            service.benefits.map((benefit) => (
              <article class="benefit-card relative flex h-full flex-col rounded-2xl p-5 lg:p-6">
                <h3 class="mb-2 text-lg font-semibold leading-snug text-navy lg:text-xl">
                  {benefit.title}
                </h3>
                <p class="text-base font-medium leading-relaxed text-navy/70">{benefit.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="capabilities-panel relative overflow-hidden py-10 text-white lg:py-12">
      <div
        class="capabilities-glow pointer-events-none absolute inset-x-0 bottom-0 h-40 lg:h-48"
        aria-hidden="true"
      ></div>
      <div class="capabilities-grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-site px-6 lg:px-[28px]">
        <div class="mb-6 grid grid-cols-1 gap-3 lg:mb-8 lg:grid-cols-4 lg:gap-0 lg:items-center">
          <SeoLabel variant="light">Možnosti &amp; Realizace</SeoLabel>
          <h2
            class="text-xl font-semibold leading-snug tracking-tight text-white sm:text-2xl lg:col-span-2 lg:col-start-3 lg:text-[36px] lg:leading-[1.15]"
          >
            Realizace a montáž našich celků.
          </h2>
        </div>

        <div class="capabilities-table">
          <div
            class="mb-0 hidden border-b border-dashed border-white/20 pb-3 lg:grid lg:grid-cols-4 lg:gap-0"
          >
            <span class="lg:col-start-2 text-sm font-medium text-white/55">Kategorie</span>
            <span class="lg:col-span-2 lg:col-start-3 lg:pl-10 text-sm font-medium text-white/55"
              >Detaily</span
            >
          </div>

          {
            service.capabilities.map((capability) => (
              <div class="capabilities-row grid grid-cols-1 gap-3 border-b border-dashed border-white/20 py-4 last:border-b-0 lg:grid-cols-4 lg:gap-0 lg:py-5">
                <h3 class="text-base font-semibold leading-snug text-white lg:col-start-2 lg:pr-6 lg:text-lg">
                  {capability.title}
                </h3>
                <ul class="space-y-1.5 text-sm font-medium leading-snug text-white/80 lg:col-span-2 lg:col-start-3 lg:pl-10 lg:text-base">
                  {capability.items.map((item) => {
                    const colon = item.indexOf(':');
                    const hasLabel = colon > 0 && colon < 40;
                    const label = hasLabel ? item.slice(0, colon + 1) : null;
                    const rest = hasLabel ? item.slice(colon + 1) : item;
                    return (
                      <li class="flex items-start gap-2.5">
                        <span
                          class="mt-2 h-1 w-1 shrink-0 rounded-full bg-gold"
                          aria-hidden="true"
                        />
                        <span>
                          {label ? <strong class="font-semibold text-white">{label}</strong> : null}
                          {rest}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="process-panel relative overflow-hidden pt-12 pb-8 lg:pt-24 lg:pb-10">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-8 xl:gap-12">
          <div class="max-w-md shrink-0 text-center sm:text-left lg:max-w-[320px] xl:max-w-md">
            <SeoLabel class="mx-auto mb-4 sm:mx-0 sm:mb-5">Jak fungujeme</SeoLabel>
            <h2
              class="text-2xl font-semibold leading-snug tracking-tight text-navy sm:text-3xl md:text-4xl lg:text-[42px] lg:leading-[1.2]"
            >
              Náš <span class="text-gold">osvědčený</span> postup realizace.
            </h2>
          </div>

          <div
            class="process-circles relative mx-auto flex w-full max-w-[720px] flex-wrap items-center justify-center gap-3 sm:flex-nowrap sm:gap-0 lg:mx-0 lg:max-w-none lg:justify-end"
            aria-label="Postup realizace"
          >
            {
              processSteps.map((item, index) => {
                const variant =
                  index === 0 ? 'navy' : index === 1 ? 'white' : 'glow';
                const stepClass =
                  index === 0
                    ? 'text-gold'
                    : index === 1
                      ? 'text-gold'
                      : 'text-white';
                const titleClass =
                  index === 0
                    ? 'text-white'
                    : index === 1
                      ? 'text-gold'
                      : 'text-white';
                return (
                  <article
                    class:list={[
                      'process-circle',
                      `process-circle--${variant}`,
                      index === 1 ? 'z-[3]' : index === 2 ? 'z-[2]' : 'z-[1]',
                      index > 0 && 'process-circle--overlap',
                    ]}
                  >
                    <p class:list={['text-xs font-semibold sm:text-sm md:text-base', stepClass]}>{item.step}</p>
                    <h3
                      class:list={[
                        'mt-1.5 max-w-[8.5rem] text-sm font-semibold leading-snug sm:mt-2 sm:max-w-[9.5rem] sm:text-base md:text-lg',
                        titleClass,
                      ]}
                    >
                      {item.title}
                    </h3>
                  </article>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <section class="services-watermark relative pt-8 pb-16 lg:pt-10 lg:pb-24">
      <div class="relative mx-auto max-w-site px-6 lg:px-[28px]">
        <div class="mb-8 text-center lg:mb-14">
          <SeoLabel class="mx-auto mb-4 sm:mb-5">Časté dotazy</SeoLabel>
          <h2
            class="text-2xl font-semibold leading-snug tracking-tight text-navy sm:text-3xl md:text-4xl lg:text-[58px] lg:leading-[1.2]"
          >
            Často kladené dotazy
          </h2>
        </div>

        <div class="faq-frame mx-auto w-full max-w-2xl rounded-2xl p-2.5 sm:p-4">
          <div class="space-y-3">
            {
              service.faqs.map((faq, index) => (
                <details
                  class="faq-item group w-full overflow-hidden rounded-[14px] bg-white shadow-[0_8px_30px_rgba(16,16,41,0.08)]"
                  open={index === 0}
                >
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-3.5 sm:gap-5 sm:p-5 lg:gap-6 lg:p-5 [&::-webkit-details-marker]:hidden">
                    <span class="min-w-0 flex-1 text-left text-sm font-semibold text-navy sm:text-base lg:text-lg">
                      {faq.question}
                    </span>
                    <span
                      class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold text-lg font-light leading-none text-white sm:h-9 sm:w-9 sm:text-xl"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </summary>
                  <div class="-mt-1 px-4 pb-4 sm:px-5 sm:pb-5 lg:px-5 lg:pb-5">
                    <p class="text-base font-medium leading-relaxed text-navy/70">
                      {faq.answer}
                    </p>
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .benefit-card {
    background: transparent;
    border: none;
  }

  .benefit-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(
      165deg,
      #101029 0%,
      #3d2e1a 40%,
      #d49d39 70%,
      #8e6b33 100%
    );
    pointer-events: none;
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask-composite: exclude;
  }

  .benefit-card > * {
    position: relative;
    z-index: 1;
  }

  .capabilities-panel {
    /* Brand navy from gold→navy scale (#101029), not near-black */
    background: #101029;
  }

  .capabilities-glow {
    /* Full-width gold band (brand #d49d39), not a center blob */
    background:
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(212, 157, 57, 0.06) 28%,
        rgba(212, 157, 57, 0.28) 62%,
        rgba(212, 157, 57, 0.55) 88%,
        rgba(212, 157, 57, 0.72) 100%
      ),
      radial-gradient(
        ellipse 120% 90% at 50% 100%,
        rgba(255, 180, 18, 0.35) 0%,
        rgba(212, 157, 57, 0.2) 40%,
        transparent 72%
      );
  }

  .capabilities-grid-lines {
    background-image:
      /* vertical dashed columns (4) */
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      );
    background-size: 1px 100%, 1px 100%, 1px 100%, 1px 100%;
    background-position: 0 0, 25% 0, 50% 0, 75% 0;
    background-repeat: no-repeat;
    opacity: 0.55;
    mask-image: linear-gradient(180deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  @media (max-width: 1023px) {
    .capabilities-grid-lines {
      display: none;
    }
  }

  .process-circle {
    display: flex;
    width: min(46vw, 150px);
    flex-shrink: 0;
    aspect-ratio: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    padding: 0.85rem;
    text-align: center;
    box-shadow: 0 16px 40px rgba(16, 16, 41, 0.14);
  }

  .process-circle--overlap {
    margin-left: 0;
  }

  @media (min-width: 640px) {
    .process-circle {
      width: min(30vw, 200px);
      padding: 1rem;
    }

    .process-circle--overlap {
      margin-left: -1rem;
    }
  }

  @media (min-width: 1024px) {
    .process-circle {
      width: min(38vw, 240px);
      padding: 1.25rem;
    }

    .process-circle--overlap {
      margin-left: -1.75rem;
    }
  }

  .process-circle--navy {
    /* Brand scale: navy → gold (not flat near-black) */
    background: linear-gradient(
      165deg,
      #101029 0%,
      #15102a 42%,
      #3d2e1a 78%,
      #8e6b33 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
  }

  .process-circle--white {
    background: #fff;
  }

  .process-circle--glow {
    background:
      radial-gradient(
        circle at 88% 12%,
        rgba(255, 180, 18, 0.95) 0%,
        rgba(212, 157, 57, 0.55) 22%,
        rgba(16, 16, 41, 0.15) 48%,
        transparent 62%
      ),
      linear-gradient(
        200deg,
        #101029 0%,
        #15102a 55%,
        #3d2e1a 100%
      );
    background-repeat: no-repeat;
    background-size: 100% 100%, 100% 100%;
  }

  @media (min-width: 1024px) {
    .process-circle {
      width: min(22vw, 280px);
    }

    .process-circle--overlap {
      margin-left: -3rem;
    }
  }

  @media (min-width: 1280px) {
    .process-circle {
      width: 300px;
    }

    .process-circle--overlap {
      margin-left: -3.5rem;
    }
  }
</style>
