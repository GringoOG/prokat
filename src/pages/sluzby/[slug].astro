---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import FlipButton from '../../components/FlipButton.astro';
import { getServiceBySlug, processSteps, services } from '../../data/services';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { slug: service.slug },
  }));
}

const { slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  throw new Error(`Unknown service slug: ${slug}`);
}
---

<Layout title={`${service.title} | Prokat Invest`} description={service.description}>
  <div class="services-watermark relative">
    <Navbar />

    <section class="pb-0 pt-8 lg:pt-28">
      <div class="mx-auto max-w-site px-6 text-center lg:px-10">
        <h1
          class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.2]"
        >
          {service.title}
        </h1>
        <div class="mt-8 mb-10 flex justify-center lg:mb-14">
          <FlipButton href="/kontakt" label="Nezávazná nabídka zdarma." />
        </div>
      </div>
    </section>
  </div>

  <main>
    <section class="services-watermark">
      <div class="mx-auto max-w-[1280px]">
        <div class="aspect-[16/9] w-full overflow-hidden sm:aspect-[2/1]">
          <img
            src={service.image}
            alt={service.title}
            class="h-full w-full object-cover object-center"
            width="1280"
            height="640"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="services-watermark py-16 lg:py-24">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <p
          class="mb-6 inline-flex w-fit items-center gap-2.5 rounded-full border border-gray-300 bg-white/80 px-4 py-2 text-sm font-medium text-navy md:text-base"
        >
          <span class="h-2 w-2 shrink-0 rounded-[2px] bg-gold" aria-hidden="true"></span>
          Přehled služby
        </p>
        <h2
          class="mb-6 text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[42px] lg:leading-[1.2]"
        >
          {service.overviewTitle}
        </h2>
        <div class="space-y-5 text-base font-medium leading-relaxed text-navy/80 lg:text-lg">
          {service.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <img
          src={service.heroImage}
          alt={`Schéma — ${service.title}`}
          class="mx-auto mb-12 h-auto w-full object-contain lg:mb-16"
          width="2400"
          height="1000"
          loading="lazy"
        />
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {
            service.benefits.map((benefit) => (
              <article class="rounded-2xl bg-white/90 p-6 shadow-sm lg:p-8">
                <img
                  src="/icons/service-icon.png"
                  alt=""
                  class="mb-5 h-9 w-9 object-contain"
                  width="36"
                  height="36"
                  aria-hidden="true"
                />
                <h3 class="mb-3 text-lg font-semibold leading-snug text-navy lg:text-xl">
                  {benefit.title}
                </h3>
                <p class="text-base font-medium leading-relaxed text-navy/70">{benefit.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="capabilities-panel relative overflow-hidden py-16 text-white lg:py-24">
      <div class="capabilities-glow pointer-events-none absolute inset-x-0 bottom-0 h-48" aria-hidden="true"
      ></div>
      <div class="capabilities-grid-lines pointer-events-none absolute inset-0" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-site px-6 lg:px-10">
        <div class="mb-10 grid grid-cols-1 gap-6 lg:mb-14 lg:grid-cols-4 lg:gap-0 lg:items-center">
          <p
            class="inline-flex w-fit items-center gap-2.5 rounded-full border border-white/30 px-4 py-2 text-sm font-medium text-white"
          >
            <span class="h-2 w-2 shrink-0 rounded-[2px] bg-gold" aria-hidden="true"></span>
            Možnosti &amp; Realizace
          </p>
          <h2
            class="text-3xl font-semibold leading-snug tracking-tight text-white sm:text-4xl lg:col-span-2 lg:col-start-3 lg:text-[42px] lg:leading-[1.15]"
          >
            Realizace a montáž našich celků.
          </h2>
        </div>

        <div class="capabilities-table">
          <div
            class="mb-0 hidden border-b border-dashed border-white/20 pb-4 lg:grid lg:grid-cols-4 lg:gap-0"
          >
            <span class="lg:col-start-2 text-sm font-medium text-white/55">Kategorie</span>
            <span class="lg:col-span-2 lg:col-start-3 lg:pl-10 text-sm font-medium text-white/55"
              >Detaily</span
            >
          </div>

          {
            service.capabilities.map((capability) => (
              <div class="capabilities-row grid grid-cols-1 gap-4 border-b border-dashed border-white/20 py-8 last:border-b-0 lg:grid-cols-4 lg:gap-0 lg:py-10">
                <h3 class="text-lg font-semibold leading-snug text-white lg:col-start-2 lg:pr-6 lg:text-[22px]">
                  {capability.title}
                </h3>
                <ul class="space-y-2.5 text-base font-medium leading-relaxed text-white/80 lg:col-span-2 lg:col-start-3 lg:pl-10 lg:text-lg">
                  {capability.items.map((item) => {
                    const colon = item.indexOf(':');
                    const hasLabel = colon > 0 && colon < 40;
                    const label = hasLabel ? item.slice(0, colon + 1) : null;
                    const rest = hasLabel ? item.slice(colon + 1) : item;
                    return (
                      <li class="flex items-start gap-3">
                        <span
                          class="mt-2.5 h-1 w-1 shrink-0 rounded-full bg-white/70"
                          aria-hidden="true"
                        />
                        <span>
                          {label ? <strong class="font-semibold text-white">{label}</strong> : null}
                          {rest}
                        </span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <p
          class="mb-4 inline-flex w-fit items-center gap-2.5 rounded-full border border-gray-300 bg-white/80 px-4 py-2 text-sm font-medium text-navy md:text-base"
        >
          <span class="h-2 w-2 shrink-0 rounded-[2px] bg-gold" aria-hidden="true"></span>
          Jak fungujeme
        </p>
        <h2
          class="mb-10 text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:mb-14 lg:text-[42px] lg:leading-[1.2]"
        >
          Náš osvědčený postup realizace.
        </h2>

        <div class="grid grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
          {
            processSteps.map((item, index) => (
              <article class="relative rounded-2xl border border-gray-100 bg-white/90 p-6 lg:p-8">
                <p class="mb-3 text-sm font-medium text-gold">{item.step}</p>
                <h3 class="text-xl font-semibold leading-snug text-navy lg:text-2xl">{item.title}</h3>
                {index < processSteps.length - 1 && (
                  <span
                    class="pointer-events-none absolute right-4 top-8 hidden text-gold/40 md:block"
                    aria-hidden="true"
                  >
                    →
                  </span>
                )}
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="py-16 lg:py-24">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <div class="mb-12 text-center">
          <p class="mb-4 inline-flex items-center gap-2 text-sm font-medium text-navy md:text-[24px]">
            <span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
            Časté dotazy
          </p>
          <h2
            class="text-3xl font-semibold leading-snug tracking-tight text-navy sm:text-4xl lg:text-[58px] lg:leading-[1.25]"
          >
            Často kladené dotazy
          </h2>
        </div>

        <div class="mx-auto max-w-3xl space-y-3">
          {
            service.faqs.map((faq, index) => (
              <details
                class="faq-item group overflow-hidden rounded-2xl border border-gray-100 bg-white/90"
                open={index === 0}
              >
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 sm:gap-4 sm:p-6 lg:p-8 [&::-webkit-details-marker]:hidden">
                  <span class="text-left text-sm font-semibold text-navy sm:text-base lg:text-xl">
                    {faq.question}
                  </span>
                  <span
                    class="faq-icon flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xl font-light leading-none text-gold"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <div class="-mt-2 px-4 pb-4 sm:px-6 sm:pb-6 lg:px-8 lg:pb-8">
                  <p class="text-base font-medium leading-relaxed text-navy/70 lg:text-lg">
                    {faq.answer}
                  </p>
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-icon {
    transition: transform 0.2s ease;
  }

  .capabilities-panel {
    background: #08080f;
  }

  .capabilities-glow {
    background: radial-gradient(
      ellipse 90% 100% at 50% 100%,
      rgba(212, 157, 57, 0.55) 0%,
      rgba(212, 157, 57, 0.18) 42%,
      transparent 72%
    );
  }

  .capabilities-grid-lines {
    background-image:
      /* vertical dashed columns (4) */
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      ),
      repeating-linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.14) 0 3px,
        transparent 3px 9px
      );
    background-size: 1px 100%, 1px 100%, 1px 100%, 1px 100%;
    background-position: 0 0, 25% 0, 50% 0, 75% 0;
    background-repeat: no-repeat;
    opacity: 0.55;
    mask-image: linear-gradient(180deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  @media (max-width: 1023px) {
    .capabilities-grid-lines {
      display: none;
    }
  }
</style>
