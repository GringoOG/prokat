---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ClientLogos from '../components/ClientLogos.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceList from '../components/ServiceList.astro';
import FlipButton from '../components/FlipButton.astro';
import SeoLabel from '../components/SeoLabel.astro';
---

<Layout>
  <link slot="head" rel="preload" as="image" href="/images/vzt-poster.jpg" type="image/jpeg" fetchpriority="high" />
  <div class="section-watermark relative bg-[#f6f6f6]">
    <Navbar solidBackground />

    <!-- HERO -->
    <section class="reveal-skip pb-0">
      <div
        class="hero-shell relative mx-auto flex max-w-site flex-col justify-center overflow-hidden px-4 pb-0 pt-8 sm:px-6 sm:pt-10 lg:px-[28px] lg:pt-16"
      >
        <video
          id="hero-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/images/vzt-poster.jpg"
          class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
          aria-label="Průmyslové vzduchotechnické zařízení"
        >
          <source src="/videos/vzt.mp4" type="video/mp4" />
          <source src="/videos/vzt.webm" type="video/webm" />
        </video>
        <div class="pointer-events-none absolute inset-0 bg-black/15" aria-hidden="true"></div>
        <div
          class="pointer-events-none absolute left-0 top-0 h-full w-full bg-gradient-to-r from-white via-white/90 to-transparent sm:w-[90%] sm:via-white/85 md:w-[75%] lg:w-[55%] lg:via-white/80"
          aria-hidden="true"
        ></div>
        <div class="relative z-10 w-full">
          <div class="flex w-full max-w-3xl flex-col items-start gap-9 text-left sm:gap-10 lg:gap-11">
            <SeoLabel class="mb-0 max-w-full !justify-start !text-left !text-xs sm:!text-sm md:!text-base">
              Váš spolehlivý partner pro technologické celky
            </SeoLabel>

            <div class="space-y-3">
              <h1
                class="text-[clamp(1.625rem,0.75rem+2.6vw,3.25rem)] font-semibold leading-[1.12] tracking-tight text-navy text-left lg:leading-[1.15]"
              >
                Od <span class="text-gold">návrhu</span> až po spuštění zdroje.
              </h1>
              <p class="text-base font-semibold leading-snug text-navy text-left md:text-lg lg:text-[20px]">
                Provozní úspory 10–20&nbsp;% nákladů pomocí <span class="text-gold">AI</span> managementu.
              </p>
            </div>

            <div class="w-full max-w-[calc(36rem-20px)] space-y-5">
              <div class="space-y-2.5">
                <p class="text-sm font-medium text-gold md:text-base lg:text-[18px]">Od roku 1999</p>
                <p class="text-sm font-medium leading-relaxed text-navy/75 md:text-base lg:text-[18px]">
                  Spolehlivý partner pro systémová řešení vzduchotechniky, vytápění, chlazení a ZTI —
                  včetně měření a regulace s využitím AI. Kompletní služby od studie a projektu až po realizaci,
                  servis a vzdálený dohled.
                </p>
              </div>

              <div class="flex w-full flex-wrap items-center justify-start gap-x-3 gap-y-2 sm:justify-between md:flex-nowrap">
                <p class="shrink-0 text-xs font-semibold text-navy sm:text-sm lg:text-[17px]">
                  25+&nbsp;let
                </p>
                <a
                  href="/o-nas"
                  class="inline-flex shrink-0 opacity-95 transition-opacity hover:opacity-100"
                  aria-label="Czech Stability Award AAA Excellent — více na stránce O nás"
                >
                  <img
                    src="/images/czech-stability-award-bw.png"
                    alt="Czech Stability Award AAA Excellent"
                    width="270"
                    height="367"
                    class="h-auto w-6 bg-transparent brightness-0 sm:w-[30px] lg:w-[34px]"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <a
                  href="/o-nas"
                  class="inline-flex shrink-0 opacity-95 transition-opacity hover:opacity-100"
                  aria-label="CRIF Business Elite 2026 — více na stránce O nás"
                >
                  <img
                    src="/images/crif-elite-badge.png"
                    alt="CRIF Business Elite 2026 — Czech Republic"
                    width="140"
                    height="102"
                    class="h-auto w-10 sm:w-[54px] lg:w-[58px]"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <p class="shrink-0 text-xs font-semibold text-navy sm:text-sm lg:text-[17px]">
                  1500+&nbsp;celků
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <script>
        const heroVideo = document.getElementById('hero-video');
        if (heroVideo instanceof HTMLVideoElement) {
          const tryPlay = () => {
            heroVideo.play().catch(() => {});
          };

          if (heroVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
            tryPlay();
          } else {
            heroVideo.addEventListener('loadeddata', tryPlay, { once: true });
          }
        }
      </script>
    </section>
  </div>

  <main>
    <!-- STATISTIKY -->
    <section
      id="statistiky"
      class="relative scroll-mt-8 overflow-hidden bg-gradient-to-b from-[#101029] via-[#1a1528] to-[#8e6b33] py-10 sm:scroll-mt-10 sm:py-12 lg:scroll-mt-12 lg:py-14"
    >
      <div class="mx-auto max-w-site px-4 text-center sm:px-6 lg:px-[28px]">
        <p class="mx-auto mb-5 max-w-3xl text-base font-medium text-white/90 sm:text-lg md:text-[23px]">
          Realizujeme technologické celky včetně studie energetické hospodárnosti, projektu, realizace, záručního a
          pozáručních servisu
        </p>

        <FlipButton
          href="/o-nas"
          label="Více o naší společnosti"
          class="mb-8 w-full justify-center sm:w-auto lg:mb-10"
        />

        <div class="relative mx-auto w-full max-w-[760px] xl:max-w-[980px]">
          <!-- Mobil: úplně pod sebou -->
          <div class="flex flex-col items-center gap-6 lg:hidden">
            <div
              class="flex aspect-square w-[min(100%,320px)] flex-col items-center justify-center rounded-full bg-white px-8 py-6 shadow-2xl"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-5xl font-semibold leading-none text-stat">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-3 text-center text-base font-medium leading-snug text-navy">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-xl font-semibold text-navy">4.9</span>
                <span class="text-base font-medium text-navy">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>
            <div
              class="aspect-square w-[min(100%,280px)] shrink-0 overflow-hidden rounded-full border-4 border-white/20 shadow-xl sm:w-[min(100%,220px)]"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>
            <div
              class="stats-years-circle flex aspect-square w-[min(100%,300px)] flex-col items-center justify-between overflow-hidden rounded-full border border-black/30 px-7 py-6 shadow-2xl"
            >
              <div class="flex flex-col items-center">
                <p class="text-sm font-medium text-white/80">// 1999-2026 //</p>
                <p class="mt-2 text-5xl font-semibold leading-none text-gold">25+</p>
                <p class="mt-3 text-center text-sm leading-relaxed text-white/90">
                  Garantujeme špičkovou kvalitu realizací již od samého začátku.
                </p>
              </div>
              <img
                src="/images/kotel.png"
                alt=""
                class="h-32 w-auto max-h-[42%] shrink-0 object-contain"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Tablet / menší desktop: trojúhelník (2 nahoře, 1 dole) -->
          <div class="relative mx-auto hidden aspect-square w-full max-w-[640px] lg:block xl:hidden">
            <div
              class="absolute left-0 top-0 z-30 flex h-[min(42%,270px)] w-[min(42%,270px)] flex-col items-center justify-center rounded-full bg-white px-5 shadow-2xl"
            >
              <img src="/images/logo.png" alt="" class="mb-2 h-7 opacity-80" aria-hidden="true" />
              <p class="text-4xl font-semibold leading-none text-stat lg:text-[48px]">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-2 max-w-[200px] text-center text-sm font-medium leading-snug text-navy">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-2 flex items-center gap-1">
                <span class="text-lg font-semibold text-navy">4.9</span>
                <span class="text-sm font-medium text-navy">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-1.5 h-3" />
              </div>
            </div>

            <div
              class="absolute right-0 top-0 z-20 h-[min(42%,270px)] w-[min(42%,270px)] overflow-hidden rounded-full border-4 border-white/20 shadow-2xl"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>

            <div
              class="stats-years-circle absolute bottom-0 left-1/2 z-20 flex h-[min(40%,250px)] w-[min(40%,250px)] -translate-x-1/2 flex-col items-center justify-between overflow-hidden rounded-full border border-black/30 px-4 py-4 shadow-2xl"
            >
              <div class="flex flex-col items-center">
                <p class="text-sm font-medium text-white/80">// 1999-2026 //</p>
                <p class="mt-1 text-4xl font-semibold leading-none text-gold">25+</p>
                <p class="mt-1.5 max-w-[190px] text-center text-xs leading-relaxed text-white/90">
                  Garantujeme špičkovou kvalitu realizací již od samého začátku.
                </p>
              </div>
              <img
                src="/images/kotel.png"
                alt=""
                class="h-24 w-auto max-h-[40%] shrink-0 object-contain"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Široký desktop: v řadě, mírný překryv -->
          <div class="mx-auto hidden items-center justify-center xl:flex">
            <div
              class="relative z-30 -mr-7 flex h-[300px] w-[300px] shrink-0 flex-col items-center justify-center rounded-full bg-white px-8 shadow-2xl 2xl:-mr-8 2xl:h-[320px] 2xl:w-[320px]"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-[56px] font-semibold leading-none text-stat 2xl:text-[64px]">
                1500<span class="text-navy">+</span>
              </p>
              <p
                class="mt-3 max-w-[230px] text-center text-[18px] font-medium leading-snug text-navy 2xl:text-[20px]"
              >
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-[24px] font-semibold text-navy 2xl:text-[26px]">4.9</span>
                <span class="text-[20px] font-medium text-navy 2xl:text-[22px]">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>

            <div
              class="relative z-20 -mr-6 h-[300px] w-[300px] shrink-0 overflow-hidden rounded-full border-4 border-white/20 shadow-2xl 2xl:-mr-7 2xl:h-[320px] 2xl:w-[320px]"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>

            <div
              class="stats-years-circle relative z-10 flex h-[300px] w-[300px] shrink-0 flex-col items-center justify-between overflow-hidden rounded-full border border-black/30 px-8 py-6 shadow-2xl 2xl:h-[320px] 2xl:w-[320px]"
            >
              <div class="flex flex-col items-center">
                <p class="text-base font-medium text-white/80 2xl:text-lg">// 1999-2026 //</p>
                <p class="mt-1 text-[52px] font-semibold leading-none text-gold 2xl:text-[60px]">25+</p>
                <p class="mt-2 max-w-[200px] text-center text-sm leading-relaxed text-white/90">
                  Garantujeme špičkovou kvalitu realizací již od samého začátku.
                </p>
              </div>
              <img
                src="/images/kotel.png"
                alt=""
                class="h-28 w-auto max-h-[42%] shrink-0 object-contain 2xl:h-32"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="site-bg-restart">
      <!-- SLUŽBY -->
      <section class="services-watermark pt-12 pb-6 sm:pt-16 sm:pb-8 lg:pt-24 lg:pb-10">
        <div class="mx-auto max-w-site px-4 sm:px-6 lg:px-[28px]">
          <div class="mb-8 flex flex-col gap-6 sm:mb-10 lg:mb-12 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0 max-w-3xl space-y-4">
              <SeoLabel>Co děláme</SeoLabel>
              <h2 class="text-2xl font-semibold leading-snug tracking-tight text-navy sm:text-3xl md:text-4xl lg:text-[58px] lg:leading-[1.25]">
                Flexibilní řešení pro <span class="text-gold">široký</span> rozsah použití TZB systémů
              </h2>
            </div>
            <FlipButton
              href="/sluzby"
              label="Prozkoumejte naše služby"
              class="w-full shrink-0 self-start sm:w-auto"
            />
          </div>

          <ServiceList />
        </div>
      </section>

      <CtaBanner />
      <ClientLogos />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .hero-mark {
    opacity: 0;
    animation: hero-mark-in 0.7s ease forwards;
    animation-delay: 2.5s;
  }

  @keyframes hero-mark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.08;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark {
      animation: none;
      opacity: 0.08;
    }
  }

  /* Pin end colors so the circle never shows a seam of the opposite stop */
  .stats-years-circle {
    overflow: hidden;
    isolation: isolate;
    background-color: #101029;
    background-image: linear-gradient(
      180deg,
      #101029 0%,
      #101029 12%,
      #1a1528 38%,
      #6b5428 72%,
      #a67c37 88%,
      #a67c37 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-clip: padding-box;
  }
</style>
