---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ClientLogos from '../components/ClientLogos.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceList from '../components/ServiceList.astro';
import FlipButton from '../components/FlipButton.astro';
import SeoLabel from '../components/SeoLabel.astro';
---

<Layout>
  <link slot="head" rel="preload" as="image" href="/images/vzt-poster.jpg" type="image/jpeg" fetchpriority="high" />
  <div class="section-watermark relative">
    <Navbar />

    <!-- HERO -->
    <section class="pb-0">
      <div class="relative mx-auto max-w-site overflow-hidden px-6 pb-[10px] pt-[73px] lg:px-[28px] lg:pb-[10px] lg:pt-[185px]">
        <div
          class="relative z-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16"
        >
          <!-- Left: headline stays -->
          <div class="flex min-w-0 flex-col gap-6 text-center lg:col-span-7 lg:text-left">
            <SeoLabel class="mb-0 justify-center lg:justify-start">
              Váš spolehlivý partner pro technologické celky
            </SeoLabel>

            <div class="space-y-4">
              <h1
                class="text-4xl font-semibold leading-snug tracking-tight text-navy sm:text-5xl lg:text-[64px] lg:leading-[1.15]"
              >
                Od <span class="text-gold">návrhu</span> až po<br class="hidden sm:block" />
                spuštění zdroje.
              </h1>
              <p class="text-base font-medium leading-snug text-navy/70 md:text-lg lg:text-[20px]">
                Provozní úspory 10–20&nbsp;% nákladů pomocí <span class="text-gold">AI</span> managementu.
              </p>
            </div>
          </div>

          <!-- Right: Od roku 1999 + mark + CRIF row -->
          <div class="relative flex w-full min-w-0 flex-col text-left lg:col-span-5 lg:pt-14 xl:pt-16">
            <div class="relative min-w-0">
              <img
                src="/images/prokat-mark.png"
                alt=""
                width="928"
                height="887"
                aria-hidden="true"
                decoding="async"
                class="hero-mark pointer-events-none absolute left-1/2 top-[calc(25%-30px)] z-0 w-[min(50vw,252px)] max-w-none -translate-x-1/2 -translate-y-1/2 select-none mix-blend-multiply lg:w-[294px] xl:w-[308px]"
              />
              <div class="relative z-10 w-full max-w-[calc(36rem-20px)] space-y-3">
                <p class="text-base font-medium text-gold md:text-lg lg:text-[20px]">Od roku 1999</p>
                <p class="text-base font-medium leading-relaxed text-navy/75 md:text-lg lg:text-[20px]">
                  Spolehlivý partner pro systémová řešení vzduchotechniky, vytápění, chlazení a ZTI —
                  včetně měření a regulace s využitím AI. Kompletní služby od studie a projektu až po realizaci,
                  servis a vzdálený dohled.
                </p>
                <div class="flex w-full items-center justify-between">
                  <p class="shrink-0 whitespace-nowrap text-base font-semibold text-navy sm:text-lg lg:text-[20px]">
                    25+&nbsp;let
                  </p>
                  <a
                    href="/o-nas"
                    class="inline-flex shrink-0 opacity-95 transition-opacity hover:opacity-100"
                    aria-label="Czech Stability Award AAA Excellent — více na stránce O nás"
                  >
                    <img
                      src="/images/czech-stability-award-bw.png"
                      alt="Czech Stability Award AAA Excellent"
                      width="270"
                      height="367"
                      class="h-auto w-[32px] bg-transparent brightness-0 sm:w-[36px] lg:w-[40px]"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <a
                    href="/o-nas"
                    class="inline-flex shrink-0 opacity-95 transition-opacity hover:opacity-100"
                    aria-label="CRIF Business Elite 2026 — více na stránce O nás"
                  >
                    <img
                      src="/images/crif-elite-badge.png"
                      alt="CRIF Business Elite 2026 — Czech Republic"
                      width="140"
                      height="102"
                      class="h-auto w-[56px] sm:w-[64px] lg:w-[70px]"
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                  <p class="shrink-0 whitespace-nowrap text-base font-semibold text-navy sm:text-lg lg:text-[20px]">
                    1500+&nbsp;celků
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="pb-1 pt-10 text-center lg:pb-1.5 lg:pt-12">
          <a
            href="#statistiky"
            id="scroll-to-stats"
            class="text-lg font-medium text-navy/80 transition-colors hover:text-gold lg:text-[22px]"
          >
            Zjistit více
          </a>
        </div>
      </div>
    </section>
  </div>

  <main>
    <section
      id="technologie"
      class="relative min-h-[380px] scroll-mt-8 overflow-hidden bg-[#1a1a1a] sm:min-h-[460px] sm:scroll-mt-10 lg:min-h-[560px] lg:scroll-mt-12"
      style="background-image: url('/images/vzt-poster.jpg'); background-size: cover; background-position: center;"
    >
      <video
        id="tech-video"
        autoplay
        muted
        loop
        playsinline
        preload="none"
        poster="/images/vzt-poster.jpg"
        class="absolute inset-0 h-full w-full object-cover object-center"
        aria-label="Průmyslové vzduchotechnické zařízení"
      >
        <source src="/videos/vzt.webm" type="video/webm" />
        <source src="/videos/vzt.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 z-10 flex items-center justify-center px-6 lg:px-10">
        <h2
          class="max-w-4xl text-center text-3xl font-semibold leading-snug tracking-tight text-white drop-shadow-sm sm:text-4xl lg:text-[58px] lg:leading-[1.25]"
        >
          Nejnovější technologie.<br />
          Prověřeno v <span class="text-gold">praxi.</span><br />
          Provozně hospodárné systémy řízeny pomocí AI.
        </h2>
      </div>
      <script>
        const video = document.getElementById('tech-video');
        if (video instanceof HTMLVideoElement) {
          const tryPlay = () => {
            video.muted = true;
            const playPromise = video.play();
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch(() => {});
            }
          };

          // Load full video only when section is near viewport
          const loadAndPlay = () => {
            if (video.dataset.srcLoaded === '1') {
              tryPlay();
              return;
            }
            video.dataset.srcLoaded = '1';
            video.preload = 'auto';
            video.load();
            if (video.readyState >= 2) tryPlay();
            else video.addEventListener('loadeddata', tryPlay, { once: true });
          };

          if ('IntersectionObserver' in window) {
            const io = new IntersectionObserver(
              (entries) => {
                if (!entries.some((e) => e.isIntersecting)) return;
                loadAndPlay();
                io.disconnect();
              },
              { rootMargin: '200px 0px' },
            );
            io.observe(video);
          } else {
            loadAndPlay();
          }
        }

        const scrollToStats = document.getElementById('scroll-to-stats');
        const statsSection = document.getElementById('statistiky');

        const easeInOutCubic = (t) =>
          t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

        const smoothScrollTo = (target) => {
          const rect = target.getBoundingClientRect();
          const scrollMargin = parseFloat(getComputedStyle(target).scrollMarginTop) || 0;
          const endY = window.scrollY + rect.top - scrollMargin;
          const startY = window.scrollY;
          const distance = endY - startY;

          if (
            Math.abs(distance) < 2 ||
            window.matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            window.scrollTo(0, endY);
            return;
          }

          // Slower than native smooth scroll — scales with distance
          const duration = Math.min(2400, Math.max(1400, Math.abs(distance) * 1.15));
          const started = performance.now();

          const step = (now) => {
            const progress = Math.min(1, (now - started) / duration);
            window.scrollTo(0, startY + distance * easeInOutCubic(progress));
            if (progress < 1) requestAnimationFrame(step);
          };

          requestAnimationFrame(step);
        };

        scrollToStats?.addEventListener('click', (event) => {
          if (!(statsSection instanceof HTMLElement)) return;
          event.preventDefault();
          smoothScrollTo(statsSection);
          history.replaceState(null, '', '#statistiky');
        });
      </script>
    </section>

    <!-- STATISTIKY -->
    <section
      id="statistiky"
      class="relative scroll-mt-8 overflow-hidden bg-gradient-to-b from-[#101029] via-[#1a1528] to-[#8e6b33] py-12 sm:scroll-mt-10 lg:scroll-mt-12 lg:py-14"
    >
      <div class="mx-auto max-w-site px-6 text-center lg:px-[28px]">
        <p class="mx-auto mb-5 max-w-3xl text-lg font-medium text-white/90 md:text-[23px]">
          Realizujeme technologické celky včetně studie energetické hospodárnosti, projektu, realizace, záručního a
          pozáručních servisu
        </p>

        <FlipButton
          href="/o-nas"
          label="Více o naší společnosti"
          class="mb-8 w-full justify-center sm:w-auto sm:justify-start lg:mb-10"
        />

        <div class="relative mx-auto w-full max-w-[760px] xl:max-w-[980px]">
          <!-- Mobil: úplně pod sebou -->
          <div class="flex flex-col items-center gap-6 lg:hidden">
            <div
              class="flex aspect-square w-[min(100%,320px)] flex-col items-center justify-center rounded-full bg-white px-8 py-6 shadow-2xl"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-5xl font-semibold leading-none text-stat">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-3 text-center text-base font-medium leading-snug text-navy">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-xl font-semibold text-navy">4.9</span>
                <span class="text-base font-medium text-navy">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>
            <div
              class="h-[220px] w-[220px] shrink-0 overflow-hidden rounded-full border-4 border-white/20 shadow-xl"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>
            <div
              class="stats-years-circle flex aspect-square w-[min(100%,300px)] flex-col items-center justify-center rounded-full border border-black/30 px-8 py-6 shadow-2xl"
            >
              <p class="text-sm font-medium text-white/80">// 1999-2026 //</p>
              <p class="mt-2 text-5xl font-semibold leading-none text-gold">25+</p>
              <p class="mt-4 text-center text-sm leading-relaxed text-white/90">
                Garantujeme špičkovou kvalitu realizací již od samého začátku.
              </p>
              <img
                src="/images/kotel.png"
                alt=""
                class="mt-4 h-16 w-auto shrink-0"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Tablet / menší desktop: trojúhelník (2 nahoře, 1 dole) -->
          <div class="relative mx-auto hidden h-[560px] w-full max-w-[700px] lg:block xl:hidden">
            <div
              class="absolute left-0 top-0 z-30 flex h-[300px] w-[300px] flex-col items-center justify-center rounded-full bg-white px-8 shadow-2xl"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-[56px] font-semibold leading-none text-stat">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-3 max-w-[230px] text-center text-[18px] font-medium leading-snug text-navy">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-[24px] font-semibold text-navy">4.9</span>
                <span class="text-[20px] font-medium text-navy">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>

            <div
              class="absolute right-0 top-0 z-20 h-[300px] w-[300px] overflow-hidden rounded-full border-4 border-white/20 shadow-2xl"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>

            <div
              class="stats-years-circle absolute left-1/2 top-[250px] z-20 flex h-[280px] w-[280px] -translate-x-1/2 flex-col items-center justify-center rounded-full border border-black/30 px-7 shadow-2xl"
            >
              <p class="text-base font-medium text-white/80">// 1999-2026 //</p>
              <p class="mt-1 text-[52px] font-semibold leading-none text-gold">25+</p>
              <p class="mt-2 max-w-[220px] text-center text-sm leading-relaxed text-white/90">
                Garantujeme špičkovou kvalitu realizací již od samého začátku.
              </p>
              <img
                src="/images/kotel.png"
                alt=""
                class="mt-2 h-14 w-auto shrink-0"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Široký desktop: v řadě, mírný překryv -->
          <div class="mx-auto hidden items-center justify-center xl:flex">
            <div
              class="relative z-30 -mr-7 flex h-[300px] w-[300px] shrink-0 flex-col items-center justify-center rounded-full bg-white px-8 shadow-2xl 2xl:-mr-8 2xl:h-[320px] 2xl:w-[320px]"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-[56px] font-semibold leading-none text-stat 2xl:text-[64px]">
                1500<span class="text-navy">+</span>
              </p>
              <p
                class="mt-3 max-w-[230px] text-center text-[18px] font-medium leading-snug text-navy 2xl:text-[20px]"
              >
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-[24px] font-semibold text-navy 2xl:text-[26px]">4.9</span>
                <span class="text-[20px] font-medium text-navy 2xl:text-[22px]">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>

            <div
              class="relative z-20 -mr-6 h-[300px] w-[300px] shrink-0 overflow-hidden rounded-full border-4 border-white/20 shadow-2xl 2xl:-mr-7 2xl:h-[320px] 2xl:w-[320px]"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>

            <div
              class="stats-years-circle relative z-10 flex h-[300px] w-[300px] shrink-0 flex-col items-center justify-center rounded-full border border-black/30 px-8 shadow-2xl 2xl:h-[320px] 2xl:w-[320px]"
            >
              <p class="text-base font-medium text-white/80 2xl:text-lg">// 1999-2026 //</p>
              <p class="mt-1 text-[52px] font-semibold leading-none text-gold 2xl:text-[60px]">25+</p>
              <p class="mt-2 max-w-[200px] text-center text-sm leading-relaxed text-white/90">
                Garantujeme špičkovou kvalitu realizací již od samého začátku.
              </p>
              <img
                src="/images/kotel.png"
                alt=""
                class="mt-2 h-14 w-auto shrink-0 2xl:h-16"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLUŽBY -->
    <section class="services-watermark pt-16 pb-6 lg:pt-24 lg:pb-8">
      <div class="mx-auto max-w-site px-6 lg:px-[28px]">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
          <div class="space-y-4 max-w-3xl">
            <SeoLabel>Co děláme</SeoLabel>
            <h2 class="text-3xl sm:text-4xl lg:text-[58px] lg:leading-[1.25] font-semibold text-navy tracking-tight leading-snug">
              Flexibilní řešení pro <span class="text-gold">široký</span> rozsah použití TZB systémů
            </h2>
          </div>
          <FlipButton
            href="/sluzby"
            label="Prozkoumejte naše služby"
            class="shrink-0 self-stretch sm:self-start lg:self-auto w-full sm:w-auto"
          />
        </div>

        <ServiceList />
      </div>
    </section>

    <CtaBanner />
    <ClientLogos />
  </main>

  <Footer />
</Layout>

<style>
  .hero-mark {
    opacity: 0;
    animation: hero-mark-in 0.7s ease forwards;
    animation-delay: 2.5s;
  }

  @keyframes hero-mark-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 0.08;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-mark {
      animation: none;
      opacity: 0.08;
    }
  }

  /* Pin end colors so the circle never shows a seam of the opposite stop */
  .stats-years-circle {
    overflow: hidden;
    isolation: isolate;
    background-color: #101029;
    background-image: linear-gradient(
      180deg,
      #101029 0%,
      #101029 12%,
      #1a1528 38%,
      #6b5428 72%,
      #a67c37 88%,
      #a67c37 100%
    );
    background-repeat: no-repeat;
    background-size: 100% 100%;
    background-clip: padding-box;
  }
</style>
