---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ClientLogos from '../components/ClientLogos.astro';
import CtaBanner from '../components/CtaBanner.astro';
import ServiceList from '../components/ServiceList.astro';
import FlipButton from '../components/FlipButton.astro';
---

<Layout>
  <div class="section-watermark bg-surface relative">
    <Navbar />

    <!-- HERO -->
    <section class="pb-0">
      <div class="mx-auto max-w-site px-6 pb-0 pt-8 lg:px-10 lg:pt-28">
        <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(300px,380px)] lg:gap-x-12 xl:gap-x-16">
          <!-- Left column -->
          <div class="space-y-8 text-center lg:text-left">
            <p
              class="inline-flex max-w-full flex-wrap items-center justify-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy sm:text-xs lg:justify-start"
            >
              <span class="h-2 w-2 shrink-0 rounded-[2px] bg-gold" aria-hidden="true"></span>
              Váš spolehlivý partner pro technologické celky
            </p>

            <div class="space-y-4">
              <h1
                class="text-4xl font-semibold leading-snug tracking-tight text-navy sm:text-5xl lg:text-[64px] lg:leading-[1.15]"
              >
                Od <span class="text-gold">návrhu</span> až po<br class="hidden sm:block" />
                spuštění zdroje.
              </h1>
              <p class="text-base font-medium leading-snug text-navy/70 md:text-lg lg:text-[20px]">
                Provozní úspory 10–20&nbsp;% nákladů pomocí AI managementu.
              </p>
            </div>

            <!-- Features — style from foto 2 -->
            <div
              class="grid grid-cols-1 divide-y divide-gray-200 border-y border-gray-200 sm:grid-cols-3 sm:divide-x sm:divide-y-0"
            >
              <div class="px-0 py-5 text-left sm:px-5 sm:py-6 sm:first:pl-0 sm:last:pr-0">
                <svg class="mb-3 h-8 w-8 text-navy" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <circle cx="16" cy="16" r="5" stroke="currentColor" stroke-width="1.5"></circle>
                  <circle cx="16" cy="16" r="2" fill="#d49d39"></circle>
                  <path
                    d="M16 4v4M16 24v4M4 16h4M24 16h4"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                  <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.5"></circle>
                </svg>
                <h2 class="mb-2 text-sm font-bold uppercase tracking-wide text-navy">Řešení na míru</h2>
                <p class="text-sm font-medium leading-relaxed text-navy/65">
                  Navrhujeme efektivní a spolehlivá technická řešení.
                </p>
              </div>
              <div class="px-0 py-5 text-left sm:px-5 sm:py-6">
                <svg class="mb-3 h-8 w-8 text-navy" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <circle cx="16" cy="16" r="4" stroke="currentColor" stroke-width="1.5"></circle>
                  <circle cx="16" cy="16" r="1.8" fill="#d49d39"></circle>
                  <path
                    d="M16 6v2.5M16 23.5V26M6 16h2.5M23.5 16H26M8.8 8.8l1.8 1.8M21.4 21.4l1.8 1.8M8.8 23.2l1.8-1.8M21.4 10.6l1.8-1.8"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"></path>
                </svg>
                <h2 class="mb-2 text-sm font-bold uppercase tracking-wide text-navy">Komplexní služby</h2>
                <p class="text-sm font-medium leading-relaxed text-navy/65">
                  Od projektu a realizace až po uvedení do provozu.
                </p>
              </div>
              <div class="px-0 py-5 text-left sm:px-5 sm:py-6 sm:last:pr-0">
                <svg class="mb-3 h-8 w-8 text-navy" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                  <path d="M7 24V16M13 24V12M19 24V14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                  ></path>
                  <path
                    d="M6 22h4v2H6v-2ZM12 10h4v14h-4V10ZM18 12h4v12h-4V12Z"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linejoin="round"></path>
                  <path
                    d="M8 14c4-1 7-6 11-7l2 1"
                    stroke="#d49d39"
                    stroke-width="1.6"
                    stroke-linecap="round"></path>
                  <path d="m19 7 3 1-1 3" stroke="#d49d39" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                  ></path>
                </svg>
                <h2 class="mb-2 text-sm font-bold uppercase tracking-wide text-navy">Úspory a efektivita</h2>
                <p class="text-sm font-medium leading-relaxed text-navy/65">
                  Optimalizace provozu a snížení provozních nákladů.
                </p>
              </div>
            </div>

            <!-- Od roku 1999 — bez karty/baneru -->
            <div class="space-y-2 text-left">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-gold">Od roku 1999</p>
              <p class="max-w-xl text-base font-medium leading-relaxed text-navy/75 md:text-lg">
                Jsme spolehlivým partnerem pro systémová řešení vzduchotechniky, vytápění, chlazení a ZTI, včetně
                měření a regulace a využitím AI.
              </p>
            </div>
          </div>

          <!-- Right column: sídlo + služby, stejná šířka -->
          <div class="mx-auto flex w-full max-w-[380px] flex-col gap-4 lg:mx-0 lg:max-w-none">
            <address
              class="not-italic rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_12px_40px_rgba(16,16,41,0.08)] sm:p-7"
            >
              <div class="mb-5 flex items-center gap-3">
                <span
                  class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-navy"
                  aria-hidden="true"
                >
                  <svg class="h-4 w-4 text-gold" viewBox="0 0 16 16" fill="currentColor">
                    <path
                      d="M8 1.5a4.5 4.5 0 0 0-4.5 4.5c0 3.2 4.5 8.5 4.5 8.5s4.5-5.3 4.5-8.5A4.5 4.5 0 0 0 8 1.5Zm0 6.2a1.7 1.7 0 1 1 0-3.4 1.7 1.7 0 0 1 0 3.4Z"
                    ></path>
                  </svg>
                </span>
                <p class="text-sm font-bold uppercase tracking-[0.12em] text-gold">Sídlo společnosti</p>
              </div>

              <div class="space-y-1 text-base font-medium leading-relaxed text-navy">
                <p class="font-semibold">PROKAT invest s.r.o.</p>
                <p>Plzeňská 1348/95</p>
                <p>Praha 5</p>
                <p class="pt-2">IČ: 25238876</p>
                <p>DIČ: CZ25238876</p>
              </div>

              <div class="my-5 h-px bg-gray-200"></div>

              <div class="space-y-1 text-base font-medium leading-relaxed text-navy">
                <p>Datová schránka: ns3u7ke</p>
                <p>Společnost je zapsaná v obchodním rejstříku:</p>
                <p class="font-semibold">Městský soud v Praze, oddíl C, vložka 350481.</p>
              </div>
            </address>

            <a
              href="/sluzby"
              class="group flex w-full items-center gap-4 rounded-2xl bg-navy px-5 py-4 text-left transition-opacity hover:opacity-95"
            >
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/35"
                aria-hidden="true"
              >
                <svg class="h-5 w-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path
                    d="M4 14v-1a8 8 0 0 1 16 0v1"
                    stroke-linecap="round"></path>
                  <path
                    d="M4 14v2a2 2 0 0 0 2 2h1v-4H4ZM20 14v2a2 2 0 0 1-2 2h-1v-4h3Z"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                  <path d="M12 19v2M9 21h6" stroke-linecap="round"></path>
                </svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-semibold text-white sm:text-base">Prozkoumejte naše služby</span>
                <span class="mt-0.5 block text-xs font-medium leading-snug text-white/65 sm:text-sm">
                  Komplexní řešení pro váš provoz od návrhu až po servis.
                </span>
              </span>
              <span
                class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-gold px-3 py-2 text-xs font-semibold text-navy transition-transform group-hover:translate-x-0.5 sm:px-3.5 sm:text-sm"
              >
                Prozkoumat
                <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="M2 6h8M7 3l3 3-3 3"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </span>
            </a>
          </div>
        </div>

        <!-- Values strip -->
        <div
          class="mt-12 grid grid-cols-1 gap-6 rounded-2xl border border-gray-200 bg-white/70 px-6 py-7 sm:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-0 lg:divide-x lg:divide-gray-200 lg:px-2 lg:py-8"
        >
          <div class="flex gap-3 lg:px-5">
            <svg class="mt-0.5 h-6 w-6 shrink-0 text-navy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3 4 6v6c0 5 3.5 8.5 8 9.5 4.5-1 8-4.5 8-9.5V6l-8-3Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path d="m9 12 2 2 4-4" stroke="#d49d39" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
              ></path>
            </svg>
            <div>
              <p class="text-sm font-bold text-navy">Spolehlivost</p>
              <p class="mt-1 text-xs font-medium leading-relaxed text-navy/60">
                Dlouhodobá garance kvality realizací a servisu.
              </p>
            </div>
          </div>
          <div class="flex gap-3 lg:px-5">
            <svg class="mt-0.5 h-6 w-6 shrink-0 text-navy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 3 14 8.5 20 9l-4.5 3.8L17 19l-5-3-5 3 1.5-6.2L4 9l6-.5L12 3Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <circle cx="12" cy="12" r="1.5" fill="#d49d39"></circle>
            </svg>
            <div>
              <p class="text-sm font-bold text-navy">Kvalita</p>
              <p class="mt-1 text-xs font-medium leading-relaxed text-navy/60">
                Precizní montáž a kontrola v každé fázi projektu.
              </p>
            </div>
          </div>
          <div class="flex gap-3 lg:px-5">
            <svg class="mt-0.5 h-6 w-6 shrink-0 text-navy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.5"></circle>
              <circle cx="16" cy="9" r="3" stroke="currentColor" stroke-width="1.5"></circle>
              <path
                d="M3.5 19c.8-3 2.8-4.5 5.5-4.5S13.7 16 14.5 19M12.5 14.5c1.2-.7 2.6-1 4-1 2.7 0 4.7 1.5 5.5 4.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"></path>
              <circle cx="12.5" cy="11" r="1.2" fill="#d49d39"></circle>
            </svg>
            <div>
              <p class="text-sm font-bold text-navy">Partnerství</p>
              <p class="mt-1 text-xs font-medium leading-relaxed text-navy/60">
                Blízká spolupráce od návrhu až po provoz.
              </p>
            </div>
          </div>
          <div class="flex gap-3 lg:px-5">
            <svg class="mt-0.5 h-6 w-6 shrink-0 text-navy" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10Z"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linejoin="round"></path>
              <path d="M12 8.5c1 1.5 1.5 3 1.5 4.5" stroke="#d49d39" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
            <div>
              <p class="text-sm font-bold text-navy">Udržitelnost</p>
              <p class="mt-1 text-xs font-medium leading-relaxed text-navy/60">
                Energeticky úsporná řešení s ohledem na provoz.
              </p>
            </div>
          </div>
        </div>

        <div class="pb-3 pt-10 text-center lg:pb-4 lg:pt-14">
          <a
            href="#technologie"
            class="text-[14px] font-semibold uppercase tracking-[0.3em] text-navy/50 transition-colors hover:text-navy"
          >
            Zjistit více
          </a>
        </div>
      </div>
    </section>
  </div>

  <main>
    <section id="technologie" class="relative overflow-hidden min-h-[380px] sm:min-h-[460px] lg:min-h-[560px]">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        class="absolute inset-0 h-full w-full object-cover object-center"
        aria-label="Průmyslové vzduchotechnické zařízení"
      >
        <source src="/videos/vzt.webm" type="video/webm" />
      </video>
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 z-10 flex items-center justify-center px-6 lg:px-10">
        <h2
          class="text-center text-3xl sm:text-4xl lg:text-[58px] lg:leading-[1.25] font-semibold text-white tracking-tight max-w-4xl drop-shadow-sm leading-snug"
        >
          Nejnovější technologie.<br />
          Prověřeno v <span class="text-gold">praxi.</span><br />
          Provozně hospodárné systémy řízeny AI.
        </h2>
      </div>
    </section>

    <!-- STATISTIKY -->
    <section class="relative bg-gradient-to-b from-[#0d0d1a] via-[#1a1520] to-[#8c6c3c] py-20 lg:py-28 overflow-hidden">
      <div class="mx-auto max-w-site px-6 lg:px-10 text-center">
        <p class="text-lg md:text-[23px] font-medium text-white/90 max-w-3xl mx-auto mb-8">
          Realizujeme technologické celky včetně studie energetické hospodárnosti, projektu, realizace, záručního a
          pozáručních servisu
        </p>

        <FlipButton
          href="/o-nas"
          label="Více o naší společnosti"
          class="mb-16 w-full sm:w-auto justify-center sm:justify-start"
        />

        <div class="relative mx-auto w-full max-w-[760px] xl:max-w-[820px]">
          <!-- Mobil: přehledný stack -->
          <div class="flex flex-col items-center gap-10 lg:hidden">
            <div
              class="bg-white rounded-full w-[min(100%,320px)] aspect-square flex flex-col items-center justify-center shadow-2xl px-8 py-6"
            >
              <img src="/images/logo.png" alt="" class="h-8 mb-3 opacity-80" aria-hidden="true" />
              <p class="text-5xl font-semibold text-stat leading-none">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-3 text-center text-base font-medium leading-snug text-navy">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-xl font-semibold text-navy">4.9</span>
                <span class="text-base font-medium text-navy">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>
            <div
              class="h-[220px] w-[220px] shrink-0 overflow-hidden rounded-full border-4 border-white/20 shadow-xl"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>
            <div
              class="flex aspect-square w-[min(100%,300px)] flex-col items-center justify-center rounded-full border border-black/30 bg-[linear-gradient(180deg,#101029_0%,#1a1528_38%,#6b5428_78%,#a67c37_100%)] px-8 py-6 shadow-2xl"
            >
              <p class="text-sm font-medium text-white/80">// 1999-2026 //</p>
              <p class="mt-2 text-5xl font-semibold leading-none text-gold">25+</p>
              <p class="mt-4 text-center text-sm leading-relaxed text-white/90">
                Garantujeme špičkovou kvalitu realizací již od samého začátku.
              </p>
              <img
                src="/images/kotel.png"
                alt=""
                class="mt-4 h-16 w-auto shrink-0"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>

          <!-- Desktop: trojúhelníková kompozice (2 nahoře, 1 dole uprostřed) -->
          <div class="relative mx-auto hidden h-[660px] w-full max-w-[700px] lg:block xl:h-[700px] xl:max-w-[760px]">
            <div
              class="absolute left-0 top-0 z-30 flex h-[340px] w-[340px] flex-col items-center justify-center rounded-full bg-white px-8 shadow-2xl xl:h-[380px] xl:w-[380px]"
            >
              <img src="/images/logo.png" alt="" class="mb-3 h-8 opacity-80" aria-hidden="true" />
              <p class="text-[64px] font-semibold leading-none text-stat xl:text-[72px]">
                1500<span class="text-navy">+</span>
              </p>
              <p class="mt-3 max-w-[250px] text-center text-[20px] font-medium leading-snug text-navy xl:text-[24px]">
                Realizovaných<br />technologických celků.
              </p>
              <div class="mt-3 flex items-center gap-1">
                <span class="text-[26px] font-semibold text-navy xl:text-[28px]">4.9</span>
                <span class="text-[22px] font-medium text-navy xl:text-[26px]">/5.0</span>
                <img src="/icons/stars.svg" alt="Hodnocení 4.9 z 5" class="ml-2 h-3.5" />
              </div>
            </div>

            <div
              class="absolute right-0 top-0 z-20 h-[340px] w-[340px] overflow-hidden rounded-full border-4 border-white/20 shadow-2xl xl:h-[380px] xl:w-[380px]"
            >
              <img
                src="/images/about-industrial.jpg"
                alt="Průmyslové technologie"
                class="h-full w-full object-cover"
              />
            </div>

            <div
              class="absolute left-1/2 top-[300px] z-20 flex h-[320px] w-[320px] -translate-x-1/2 flex-col items-center justify-center rounded-full border border-black/30 bg-[linear-gradient(180deg,#101029_0%,#1a1528_38%,#6b5428_78%,#a67c37_100%)] px-8 shadow-2xl xl:top-[320px] xl:h-[340px] xl:w-[340px]"
            >
              <p class="text-lg font-medium text-white/80 xl:text-xl">// 1999-2026 //</p>
              <p class="mt-2 text-[60px] font-semibold leading-none text-gold xl:text-[72px]">25+</p>
              <p class="mt-3 max-w-[240px] text-center text-sm leading-relaxed text-white/90 xl:text-base">
                Garantujeme špičkovou kvalitu realizací již od samého začátku.
              </p>
              <img
                src="/images/kotel.png"
                alt=""
                class="mt-2 h-16 w-auto shrink-0 xl:mt-3 xl:h-20"
                width="422"
                height="482"
                aria-hidden="true"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SLUŽBY -->
    <section class="services-watermark bg-surface py-16 lg:py-24 lg:pb-40">
      <div class="mx-auto max-w-site px-6 lg:px-10">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
          <div class="space-y-4 max-w-3xl">
            <p class="inline-flex items-center gap-2 text-sm md:text-[24px] font-medium text-navy">
              <span class="h-1.5 w-1.5 rounded-full bg-gold" aria-hidden="true"></span>
              Co děláme
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-[58px] lg:leading-[1.25] font-semibold text-navy tracking-tight leading-snug">
              Flexibilní řešení pro <span class="text-gold">široký</span> rozsah použití TZB systémů
            </h2>
          </div>
          <FlipButton
            href="/sluzby"
            label="Prozkoumejte naše služby"
            class="shrink-0 self-stretch sm:self-start lg:self-auto w-full sm:w-auto"
          />
        </div>

        <ServiceList />
      </div>
    </section>

    <CtaBanner />
    <ClientLogos />
  </main>

  <Footer />
</Layout>
